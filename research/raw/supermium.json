  "pitch": "Modern Chromium for Windows XP, Vista, 7, 8 and newer.",
  "summary": "A Chromium fork that keeps current Blink/V8 running on Windows XP through 11, with Google Sync, Chrome Web Store access and ungoogled-chromium privacy flags. The only mainstream way to get a recent Chromium engine on XP/Vista/7.",
  "bestFor": [
    "Windows XP, Vista, 7 and 8 users",
    "Old PCs needing a modern engine",
    "People wanting MV2 uBlock Origin on a Chromium base"
  ],
  "notFor": [
    "Users on current Windows who want fast security patching",
    "Anyone needing macOS, Linux or mobile",
    "People who need guaranteed Netflix/DRM"
  ],
  "pros": [
    {
      "title": "Runs on XP to 11",
      "detail": "Windows XP SP1+, Vista, 7, 8, 10, 11 in 32-bit and 64-bit builds."
    },
    {
      "title": "Modern engine on old OS",
      "detail": "Tracks current Chromium major versions, so most modern sites work where Firefox ESR or old Chrome fail."
    },
    {
      "title": "Sync works on XP",
      "detail": "Google Sync is functional even on Windows XP per Wikipedia."
    },
    {
      "title": "MV2 kept",
      "detail": "Project says MV2 is not slated for removal and uBlock Origin can be sideloaded from GitHub."
    },
    {
      "title": "Light on old hardware",
      "detail": "Runs from 768 MB RAM with SSE2 or SSE3 CPUs."
    }
  ],
  "cons": [
    {
      "title": "Windows only",
      "detail": "No macOS, Linux or mobile builds."
    },
    {
      "title": "Security on legacy OS",
      "detail": "XP/Vista lack modern OS mitigations; sandbox strength is below Chrome on Windows 11."
    },
    {
      "title": "Patch lag",
      "detail": "Supermium 150 is months behind current stable Chrome; patch cadence depends on one developer."
    },
    {
      "title": "Rough edges",
      "detail": "Occasional process failures on some XP systems were still open in Oct 2026."
    }
  ],
  "signatureFeatures": [
    "Windows XP/Vista/7 support",
    "Classic Chrome UI themes",
    "Google Sync on XP",
    "ungoogled-chromium privacy flags"
  ],
  "faq": [
    {
      "q": "Does Supermium work on Windows XP in 2026?",
      "a": "Yes. Windows XP SP3 or later with a Pentium 4+ SSE2 CPU and at least 768 MB RAM; release 150 notes still list an open XP process-failure fix."
    },
    {
      "q": "Is uBlock Origin supported?",
      "a": "MV2 extensions work by sideloading per the project; Wikipedia says MV2 is not yet available, so this is contested."
    },
    {
      "q": "Is it safe to use on XP?",
      "a": "The browser engine is current-ish, but the OS itself is unpatched, so risk remains."
    }
  ],
