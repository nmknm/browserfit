  "pitch": "Chromium rebuilt with CPU optimizations and MV2 extensions kept alive.",
  "summary": "A performance-tuned Chromium fork (AVX/AVX2/SSE builds, PGO/LTO) with extra codecs and Manifest V2 uBlock Origin preinstalled. Maintainer continuity is the main risk: gz83 has been shipping unofficial-beta builds since mid-2026.",
  "bestFor": [
    "Chromium users who want MV2 uBlock Origin to keep working",
    "Enthusiasts wanting CPU-optimized builds",
    "Linux, Windows, macOS and Android users who want a de-Googled-ish Chromium"
  ],
  "notFor": [
    "Anyone needing guaranteed same-week security patches",
    "People who want built-in sync",
    "Users who need a clearly staffed project"
  ],
  "pros": [
    {
      "title": "MV2 extensions kept",
      "detail": "Release notes say uBlock Origin 1.75.0 is preinstalled and MV2 support is retained, unlike stock Chrome."
    },
    {
      "title": "CPU-optimized builds",
      "detail": "Separate SSE3/SSE4/AVX/AVX2 (and AVX-512 on Linux) builds with PGO and LTO."
    },
    {
      "title": "Wide platform reach",
      "detail": "Windows, Linux (deb/rpm/ARM64), macOS 13+, Android, Raspberry Pi and Windows-on-ARM builds."
    },
    {
      "title": "Extra codecs",
      "detail": "Proprietary codecs such as H.264 and HEVC are enabled, with hardware decode."
    },
    {
      "title": "Full Chromium compatibility",
      "detail": "Blink engine and Chrome Web Store access keep site compatibility at Chrome level."
    }
  ],
  "cons": [
    {
      "title": "Maintainer uncertainty",
      "detail": "Alex313031 has been unavailable; gz83 builds are labelled Beta because they are not officially released."
    },
    {
      "title": "Patch lag and trust",
      "detail": "Unofficial third-party binaries trail Chrome and have a smaller security team than Chrome or Brave."
    },
    {
      "title": "No built-in sync",
      "detail": "Google Sync is not available in the builds (not confirmed in the release notes)."
    },
    {
      "title": "MV2 durability",
      "detail": "Keeping MV2 requires patching around Chromium 150+ removal code each release."
    }
  ],
  "signatureFeatures": [
    "Optimized AVX/AVX2 builds",
    "Preinstalled MV2 uBlock Origin",
    "Proprietary codecs enabled",
    "Multi-platform incl. Android and Raspberry Pi"
  ],
  "faq": [
    {
      "q": "Is Thorium still maintained?",
      "a": "Yes, but by interim maintainer gz83; builds since M144 (June 2026) are posted on his fork as Beta while original author Alex313031 is unavailable."
    },
    {
      "q": "Does Thorium still support uBlock Origin?",
      "a": "Yes. Release notes say MV2 support is kept and uBO 1.75.0 is preinstalled, though community reports on MV2 beyond M150 are mixed."
    },
    {
      "q": "Does it still run on Windows 7?",
      "a": "The M150 notes say old Windows 7 files were removed; Windows 7 builds ended with the earlier M138 line."
    }
  ],
