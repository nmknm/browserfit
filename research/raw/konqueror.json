  "pitch": "KDE’s classic web browser and file manager, now on Qt WebEngine.",
  "summary": "Konqueror is the long-running KDE browser that also acts as a file manager through KIO. It now uses Qt WebEngine, offers deep per-site and KDE-style customisation, but receives mostly maintenance updates.",
  "bestFor": [
    "KDE users who want one app for web, FTP/SMB and files",
    "People who like per-site policies and split views",
    "Long-time KDE users"
  ],
  "notFor": [
    "Users wanting a modern, polished browser",
    "Extension or sync users",
    "Anyone needing strong Chromium patch timing"
  ],
  "pros": [
    {
      "title": "KIO integration",
      "detail": "Browses web, FTP, SMB, man pages and local files from one window."
    },
    {
      "title": "Per-site policies",
      "detail": "Domain-specific JavaScript, cookie and user-agent settings."
    },
    {
      "title": "Highly customisable UI",
      "detail": "KDE toolbars, shortcuts and split views."
    },
    {
      "title": "Built-in ad filter",
      "detail": "KDE AdBlock filters included."
    }
  ],
  "cons": [
    {
      "title": "Maintenance mode",
      "detail": "Recent Gear releases list only trivial Konqueror changes."
    },
    {
      "title": "Rough modern web experience",
      "detail": "Qt WebEngine integration has been less polished than Falkon."
    },
    {
      "title": "No sync, no extension store",
      "detail": "KDE plugins only."
    }
  ],
  "signatureFeatures": [
    "KIO protocols",
    "Split views",
    "Per-domain policies",
    "Web shortcuts"
  ],
  "faq": [
    {
      "q": "What engine does Konqueror use?",
      "a": "Currently Qt WebEngine (Chromium-based); earlier versions used KHTML and then QtWebKit."
    },
    {
      "q": "Is Konqueror still developed?",
      "a": "Yes, as part of KDE Gear (26.08.2 in October 2026), but changes are mostly small fixes."
    },
    {
      "q": "Is it still KDE’s file manager?",
      "a": "No. Dolphin replaced it in KDE 4 (2008), though Konqueror can still browse files."
    }
  ],
