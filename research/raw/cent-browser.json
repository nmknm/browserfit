    "People who need fast security updates",
    "Anyone who wants an open-source or audited build"
  ],
  "pros": [
    {
      "title": "Mouse gestures built in",
      "detail": "Right-button gestures switch tabs, refresh or open history without an extension."
    },
    {
      "title": "Still supports Windows 7",
      "detail": "The October 2026 changelog keeps Windows 7 support."
    },
    {
      "title": "Manifest V2 allowed",
      "detail": "The changelog says MV2 extensions still work."
    },
    {
      "title": "Chrome extensions",
      "detail": "Works with Chrome Web Store extensions; Google-account sync is supported."
    }
  ],
  "cons": [
    {
      "title": "Lagging Chromium",
      "detail": "Version 5.3 uses Chromium 150, several milestones behind Chrome."
    },
    {
      "title": "Closed source and opaque",
      "detail": "Proprietary build with little published about the developer or telemetry."
    },
    {
      "title": "Irregular updates",
      "detail": "Download sites note it is not updated as often as Chrome."
    }
  ],
  "signatureFeatures": [
    "Mouse gestures",
