  ],
  "faq": [
    {
      "q": "Is Cent Browser safe?",
      "a": "It is a Chromium build, but it trails Chrome by several milestones and is closed source, so patch speed is a concern."
    },
    {
      "q": "Does it support Manifest V2 extensions?",
      "a": "The October 2026 changelog says so; Chrome Web Store removed MV2 listings on 2026-08-31, so installs may need sideloading."
    },
    {
      "q": "Does it run on Windows 7?",
      "a": "Yes, according to the 5.3.1184.25 changelog."
    }
  ],
