  "summary": "A young, open-source desktop browser built on ungoogled-chromium that ships uBlock Origin and community filter lists enabled by default. Still beta, with no Widevine DRM and early sync work.",
  "bestFor": [
    "Chromium users who want Google removed and blocking on by default",
    "Open-source minded users on Windows, macOS or Linux",
    "People coming from Arc-style layouts who want something simple"
  ],
  "notFor": [
    "Netflix/Disney+ viewers (no Widevine reported)",
    "Users needing mobile versions or mature sync",
    "Anyone who needs a stable, long-established project"
  ],
  "pros": [
    {
      "title": "uBlock Origin built in",
      "detail": "Ships uBO with community filter lists enabled out of the box."
    },
    {
      "title": "Ungoogled base",
      "detail": "Removes Google services and tracking from Chromium."
    },
    {
      "title": "Open source",
      "detail": "GPL-3.0 code; repository passed 20k GitHub stars in Sept 2026."
    },
    {
      "title": "Fast Chromium updates",
      "detail": "Version 0.20.1 moved to Chromium 156.0.8078.47 within days."
    }
  ],
  "cons": [
