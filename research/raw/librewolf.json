  "pitch": "Firefox hardened out of the box: uBO bundled, telemetry and AI stripped or locked off.",
  "summary": "Firefox rapid-release fork with telemetry removed, uBlock Origin bundled, resist-fingerprinting on and Firefox AI features kept off by default. Desktop only; updates come through package managers.",
  "bestFor": [
    "Firefox users who want privacy defaults without manual about:config work",
    "People who want a browser with Firefox AI features off",
    "Linux users comfortable with package managers"
  ],
  "notFor": [
    "People who want automatic background updates on Windows/Linux",
    "Users who need Netflix-style DRM out of the box",
    "Android or iOS users (no mobile version)"
  ],
  "pros": [
    {
      "title": "Hardened defaults",
      "detail": "Telemetry, Pocket, sponsored content and many Mozilla connections are removed or disabled."
    },
    {
      "title": "uBlock Origin bundled",
      "detail": "A full MV2 content blocker ships preinstalled."
    },
    {
      "title": "Resist Fingerprinting",
      "detail": "RFP is on by default, spoofing timezone and window size."
    },
    {
      "title": "Firefox AI kept off",
      "detail": "AI features are disabled/locked by default, aligning with its AI-free reputation."
    },
    {
      "title": "Fast upstream tracking",
      "detail": "LibreWolf 158.0 followed Firefox 158 on the same day in Oct 2026."
    }
  ],
  "cons": [
    {
      "title": "No Android/iOS",
      "detail": "No mobile version; the FAQ points Android users to IronFox."
    },
    {
      "title": "Manual updates",
      "detail": "No built-in auto-update on Windows and Linux; depends on package managers."
    },
    {
      "title": "Site breakage",
      "detail": "RFP, disabled DRM and WebGL tweaks break some sites until adjusted."
    },
    {
      "title": "Volunteer project",
      "detail": "Small team; longevity depends on maintainers."
    }
  ],
  "signatureFeatures": [
    "uBlock Origin bundled",
    "Resist Fingerprinting",
    "No telemetry",
    "AI features off",
    "Locked privacy prefs"
  ],
  "faq": [
    {
      "q": "Is LibreWolf anti-AI?",
      "a": "It keeps Firefox AI features disabled and locked by default, but the project does not market itself as an anti-AI browser; users can opt in."
    },
    {
      "q": "Can I use Firefox Sync?",
      "a": "Yes, it can be enabled and is encrypted client-side; self-hosting a sync server is possible."
    },
    {
      "q": "Does Netflix work?",
      "a": "DRM is disabled by default; you can enable it in settings."
    }
  ],
