  "pitch": "All-in-one browser, mail, IRC and HTML composer suite descended from Netscape.",
  "summary": "The community continuation of the Mozilla Application Suite: browser, mail/news, address book, ChatZilla IRC, and Composer in one app on an old Gecko 60 base. Still maintained but struggles with modern sites.",
  "bestFor": [
    "Users who want an integrated browser, mail, IRC and HTML editor",
    "Fans of the classic Netscape/Mozilla suite",
    "Legacy XPCOM add-on users"
  ],
  "notFor": [
    "Anyone relying on modern web apps",
    "Security-sensitive users",
    "People needing WebExtensions or DRM"
  ],
  "pros": [
    {
      "title": "True all-in-one suite",
      "detail": "Browser, mail/newsgroups, RSS, ChatZilla IRC, address book and Composer in one install."
    },
    {
      "title": "Still updated",
      "detail": "2.53.24 shipped on 2026-07-28 with platform-level fixes."
    },
    {
      "title": "Open source",
      "detail": "MPL-2.0 and community governed."
    },
    {
      "title": "Highly configurable",
      "detail": "Modern and Classic skins plus legacy add-on support."
    }
  ],
  "cons": [
    {
      "title": "Old Gecko base",
      "detail": "Built on Firefox 60-era Gecko; the project admits many sites break because they require the latest Chrome or Firefox."
    },
    {
      "title": "Security debt",
      "detail": "No modern sandbox or site isolation; backports are limited."
    },
    {
      "title": "Fewer platforms",
      "detail": "x64 only now; Windows 7 x64+, macOS x64 and Linux x64."
    },
    {
      "title": "Small team",
      "detail": "A release slipped two weeks in 2026 due to infrastructure moving from Azure to OSUOSL."
    }
  ],
  "signatureFeatures": [
    "Integrated mail and news",
