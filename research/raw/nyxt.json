  "pitch": "Emacs-like, Lisp-hackable keyboard browser; 4.0 now renders with Electron.",
  "summary": "Nyxt is a programmable browser written in Common Lisp, driven by commands and key chords. Version 4.0 (Jan 2026) switched to an Electron renderer for performance and macOS/Windows plans; WebKitGTK is still possible as a source build.",
  "bestFor": [
    "Emacs and Lisp users who want to script their browser",
    "Power users who like buffers and a command palette",
    "Tinkerers who want a hackable browser"
  ],
  "notFor": [
    "Beginners and non-keyboard users",
    "People who need extensions and sync",
    "Anyone who needs predictable, easy builds"
  ],
  "pros": [
    {
      "title": "Fully hackable",
      "detail": "All source can be introspected and changed live in Common Lisp."
    },
    {
      "title": "Command-driven",
      "detail": "Emacs/vi/CUA keybindings, link hints and a command palette."
    },
    {
      "title": "Adblock by default",
      "detail": "Pre-release 10 turned adblocking on by default."
    },
    {
      "title": "Electron performance",
      "detail": "The 4.x Electron renderer improved speed over WebKitGTK."
    }
  ],
  "cons": [
    {
      "title": "Steep learning curve",
      "detail": "Lisp configuration and unusual concepts are hard for newcomers."
    },
    {
      "title": "Young Electron port",
      "detail": "WebExtensions install is only experimental and not integrated into Nyxt’s API."
    },
    {
      "title": "Packaging friction",
      "detail": "AUR reports in Aug 2026 describe broken submodule URLs and dependency pins."
    },
    {
      "title": "No sync or accounts",
      "detail": "No built-in synchronization."
    }
  ],
  "signatureFeatures": [
    "Common Lisp scripting",
    "Command palette and buffers",
    "Link hints",
    "Multi-keybinding modes (Emacs, vi, CUA)"
  ],
  "faq": [
    {
      "q": "What engine does Nyxt use now?",
      "a": "Version 4.0 defaults to Electron (Chromium); WebKitGTK remains a compile-time option on Linux."
    },
    {
      "q": "Does Nyxt run on Windows?",
      "a": "Linux and macOS are documented; Windows support via Electron is a stated goal but not confirmed here."
    },
    {
      "q": "Can I use Chrome extensions?",
      "a": "Only experimentally through cl-electron; it is not a supported feature yet."
    }
  ],
