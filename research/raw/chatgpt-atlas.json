  "faq": [
    {
      "q": "Is ChatGPT Atlas still available?",
      "a": "No. It stopped working on Aug 9, 2026; chatgpt.com/atlas now loads standard ChatGPT."
    },
    {
      "q": "Why was it shut down?",
      "a": "OpenAI lead James Sun said core capabilities moved into the redesigned ChatGPT desktop app; OpenAI gave no further explanation."
    },
    {
      "q": "Can I recover my data?",
      "a": "Data not exported before the window closed cannot be recovered."
    }
  ],
