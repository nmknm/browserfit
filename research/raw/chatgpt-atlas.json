  "pros": [
    {
      "title": "Deep ChatGPT integration",
      "detail": "Sidebar chat, cursor chat and browser memories were native."
    },
    {
      "title": "Agent mode",
      "detail": "Could complete tasks like hotel booking for Plus/Pro users."
    },
    {
      "title": "Memory controls",
      "detail": "OpenAI said memory summaries were deleted within seven days; training on browsing off by default."
    },
    {
      "title": "Passkey support",
      "detail": "iCloud Keychain passkeys supported."
    }
  ],
  "cons": [
    {
      "title": "Shut down",
      "detail": "Stopped working Aug 9, 2026, under a year after launch."
    },
    {
      "title": "Data not transferable",
      "detail": "Bookmarks, history and tabs did not move automatically; export window closed."
    },
    {
      "title": "macOS only",
      "detail": "Windows, iOS and Android were announced but not confirmed shipped."
    },
    {
      "title": "Security findings",
      "detail": "LayerX reported a memory-injection attack in Oct 2025; OpenAI said it could not reproduce it."
    }
  ],
  "signatureFeatures": [
    "ChatGPT sidebar",
