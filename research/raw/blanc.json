  "pitch": "Minimal browser where a floating \"Island\" replaces tabs and toolbar.",
  "summary": "Blanc is a brand-new Electron-based browser that replaces the tab strip and toolbar with a small floating Island showing navigation, tab dots, domain and blocked-request count. It blocks ads with EasyList/EasyPrivacy and deliberately has no extension runtime.",
  "bestFor": [
    "People who want an ultra-minimal UI",
    "Mac, Windows and Linux users wanting built-in blocking",
    "Early adopters comfortable with a new project"
  ],
  "notFor": [
    "Extension users",
    "Anyone who needs a mature, long-lived browser",
    "DRM-heavy streaming"
  ],
  "pros": [
    {
      "title": "Distinct minimal UI",
      "detail": "The Island combines navigation, address bar, command palette and quick switcher."
    },
    {
      "title": "Network-level blocking",
      "detail": "Bundled EasyList/EasyPrivacy snapshots via Ghostery adblocker, with a live blocked count."
    },
    {
      "title": "MIT source",
      "detail": "Repo is MIT-licensed with transparent release notes."
    },
    {
      "title": "Cross-platform",
      "detail": "macOS, Windows installer and Linux AppImage."
    }
  ],
  "cons": [
    {
      "title": "Very new, single maintainer",
      "detail": "Launched in 2026; long-term support is unproven."
    },
    {
      "title": "No extensions",
      "detail": "The maker shipped an extension runtime, then removed it after crashes and sandboxing/licensing issues."
    },
    {
      "title": "Nag for Patron plan",
      "detail": "OMG! Ubuntu reports a new-tab button for the paid plan that cannot be hidden."
    },
    {
      "title": "Unclear licensing signals",
      "detail": "AlternativeTo calls it source-available while the repo lists MIT."
    }
  ],
  "signatureFeatures": [
    "The Island",
    "Quick Switcher",
    "Glance side-by-side peek",
    "Built-in EasyList/EasyPrivacy blocking"
  ],
  "faq": [
    {
      "q": "Is Blanc open source?",
      "a": "The GitHub repo is MIT-licensed; AlternativeTo describes it differently, and trademarks are reserved."
    },
    {
      "q": "Does Blanc support extensions?",
      "a": "No. There is no extension runtime by design."
    },
    {
      "q": "Is Blanc free?",
      "a": "Yes; workspaces require the optional Patron plan."
    }
  ],
