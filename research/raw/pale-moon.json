  "pitch": "Independent Goanna engine, classic XUL interface and no WebExtensions.",
  "summary": "A single-process, highly customizable browser on the Goanna engine (a Gecko fork) that keeps the pre-Quantum Firefox interface and XUL add-ons. Free of telemetry and Mozilla-isms, but webcompat and security depth lag mainstream browsers.",
  "bestFor": [
    "Fans of the classic Firefox UI and XUL add-ons",
    "Low-resource and older machines (Windows 7 SP1+)",
    "People wanting a non-Chromium, non-Gecko independent engine"
  ],
  "notFor": [
    "Users who rely on modern web apps or WebRTC",
    "People who need Netflix/DRM or WebExtensions",
    "Security-sensitive users wanting multi-process sandboxing"
  ],
  "pros": [
    {
      "title": "Independent engine",
      "detail": "Goanna is a separate Gecko fork, with new CSS and JS features still landing (Cascade Layers, WeakRef, URL.parse in 2026)."
    },
    {
      "title": "Deep customization",
      "detail": "Full UI customization, themes and personas, about:config."
    },
    {
      "title": "Low resource use",
      "detail": "Single-process design needs little RAM; Windows 7 SP1 and Linux supported."
    },
    {
      "title": "No telemetry",
      "detail": "No data collection or account tie-ins."
    },
    {
      "title": "Active releases",
      "detail": "35.0.0 shipped 2026-09-17, followed by 35.0.1, 35.0.2 and 35.0.3."
    }
  ],
  "cons": [
    {
      "title": "Site compatibility",
      "detail": "Newer sites that need modern JS/CSS or WebRTC (unsupported by design) break; a Firefox UA compat mode helps partially."
    },
    {
      "title": "No WebExtensions",
      "detail": "Only legacy XUL/XPCOM add-ons from its own library; no Chrome Web Store or AMO."
    },
    {
      "title": "Weaker security model",
      "detail": "No multi-process sandbox or site isolation like Chrome and Firefox."
    },
    {
      "title": "No DRM",
      "detail": "No Widevine, so Netflix, Spotify web and similar do not work."
    },
    {
      "title": "Small team",
      "detail": "Development depends on a few volunteers; binaries are proprietary freeware."
    }
  ],
  "signatureFeatures": [
    "Goanna engine",
    "Classic XUL UI",
    "Legacy add-ons",
    "Windows 7 / Linux / macOS / FreeBSD builds"
  ],
  "faq": [
    {
      "q": "Does Pale Moon support Firefox extensions?",
      "a": "No WebExtensions. It supports its own legacy XUL/XPCOM add-ons from its add-ons site; modern Firefox add-ons will not install."
    },
    {
      "q": "Does Pale Moon run on Windows 7?",
      "a": "Yes. Wikipedia lists Windows 7 SP1 as the minimum, with AVX required for 64-bit builds."
    },
    {
      "q": "Is Pale Moon safe?",
      "a": "It receives regular security updates but lacks multi-process sandboxing, so it is less hardened than Chrome or Firefox."
    }
  ],
