  "pros": [
    {
      "title": "Regular 2026 updates",
      "detail": "Releases 2026.01.23, 03.09, 04.15, 06.12 and 09.24 added JS and CSS features (top-level await, oklch, Error.cause)."
    },
    {
      "title": "XUL add-ons",
      "detail": "Supports classic add-ons and unsigned extensions."
    },
    {
      "title": "ARM64 builds",
      "detail": "ARM64 builds run substantially as of 2026.09.24."
    },
    {
      "title": "Open source engine",
      "detail": "MPL-2.0 source on repo.palemoon.org."
    }
  ],
  "cons": [
    {
      "title": "Beta and niche",
      "detail": "Still described as beta with a small developer pool."
    },
    {
      "title": "Compat gaps",
      "detail": "Goanna lags modern web standards, and WebExtensions support was dropped in 2019."
    },
    {
      "title": "Security model",
      "detail": "Single-process, no site isolation or modern sandbox."
    },
    {
      "title": "No DRM or mobile",
      "detail": "No Widevine and desktop only."
    }
  ],
  "signatureFeatures": [
    "Goanna/UXP engine",
    "XUL add-ons",
    "Modern JS features backported in 2026",
    "ARM64 build"
  ],
  "faq": [
    {
      "q": "Is Basilisk maintained?",
      "a": "Yes, by the Basilisk Development Team since 2022; the latest release found is 2026.09.24."
    },
    {
      "q": "Is Basilisk the same as Pale Moon?",
      "a": "No. Both use UXP/Goanna, but Basilisk keeps the older Firefox-style UI and is a separate project and codebase."
    },
    {
      "q": "Which OSes does it run on?",
      "a": "Windows 7+ and Linux are fully supported; macOS and FreeBSD are experimental."
    }
  ],
