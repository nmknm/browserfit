  "pitch": "Firefox fork with Arc-style workspaces, split view and Glance.",
  "summary": "Free, open-source Firefox fork with a vertical sidebar, workspaces (\"spaces\"), folders, split view, Glance and Zen Mods. A popular Arc successor, desktop only, without Widevine DRM.",
  "bestFor": [
    "Arc users looking for a successor",
    "Firefox users who want vertical tabs and workspaces",
    "Customizers who like themes and mods"
  ],
  "notFor": [
    "Anyone who needs Netflix or Widevine DRM",
    "People who need a mobile version",
    "Users who want a fully stable non-beta release"
  ],
  "pros": [
    {
      "title": "Arc-style workflow",
      "detail": "Vertical sidebar, spaces, folders, Essentials, split view and Glance previews."
    },
    {
      "title": "Firefox engine and add-ons",
      "detail": "Full Firefox add-on catalog with MV2 uBlock Origin and Total Cookie Protection."
    },
    {
      "title": "Zen Mods",
      "detail": "Community mods and gradient themes let you restyle the UI."
    },
    {
      "title": "Fast security patching",
      "detail": "Ships Firefox security updates within days (1.23.3b moved to Firefox 158 on Oct 16)."
    },
    {
      "title": "Open source and free",
      "detail": "MPL-2.0 licensed, no ads, no subscription."
    }
  ],
  "cons": [
    {
      "title": "No official DRM",
      "detail": "Zen has not obtained a Widevine license; protected video is unreliable."
    },
    {
      "title": "Desktop only",
      "detail": "The team says it has no resources for Android or iOS versions."
    },
    {
      "title": "Still beta",
      "detail": "Every release is a \"b\" build; occasional regressions."
    },
    {
      "title": "Young project",
      "detail": "Small team; long-term sustainability unproven."
    }
  ],
  "signatureFeatures": [
    "Spaces (workspaces) with folders and Essentials",
    "Split view",
    "Glance link previews",
    "Zen Mods and gradient themes",
    "Library (1.23b)"
  ],
  "faq": [
    {
      "q": "Is Zen Browser an Arc replacement?",
      "a": "It is the most commonly recommended Arc successor: it has a similar sidebar, spaces, split view and peek-style Glance, though Arc features like Boosts are different."
    },
    {
      "q": "Does Zen play Netflix?",
      "a": "Not reliably: Zen has not received a Widevine license and its FAQ recommends another browser or the native app for DRM video."
    },
    {
      "q": "Is there a Zen app for phones?",
      "a": "No. The team says it lacks the resources and vertical tabs do not translate to mobile; sync with Firefox on your phone instead."
    }
  ],
