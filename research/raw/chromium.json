  ],
  "faq": [
    {
      "q": "What is the difference between Chrome and Chromium?",
      "a": "Chrome is Google's branded binary built on Chromium, adding auto-update, Widevine, proprietary codecs, Google sync and telemetry."
    },
    {
      "q": "Where do I get Chromium builds?",
      "a": "Linux distributions package it; Google publishes per-commit snapshots for Windows, macOS, Linux and Android. Android builds are sideloaded APKs."
    },
    {
      "q": "Does Chromium update itself?",
      "a": "No official auto-updater. Use your package manager or fetch new snapshots."
    }
  ],
