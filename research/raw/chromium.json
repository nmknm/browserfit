  "pros": [
    {
      "title": "Open source",
      "detail": "BSD-style licensed code you can audit and build."
    },
    {
      "title": "Latest engine",
      "detail": "Blink/V8 equal to Chrome performance."
    },
    {
      "title": "No Google account tie-in",
      "detail": "No Chrome sync and no Google branding, usage metrics or crash reporting."
    },
    {
      "title": "Distro-packaged",
      "detail": "Debian, Arch, Fedora and others ship Chromium with proprietary codecs enabled by their builds."
    }
  ],
  "cons": [
    {
      "title": "No auto-update",
      "detail": "Official binaries lack automatic updates, so patching depends on you or your distro."
    },
    {
      "title": "No Widevine",
      "detail": "No Netflix-style DRM by default; official builds lack licensed codecs."
    },
    {
      "title": "No sync",
      "detail": "Chrome sync is blocked for Chromium builds since 2021."
    },
    {
      "title": "No MV2",
      "detail": "MV2 code was removed in Chromium 151; Chrome Web Store is unofficially usable."
    }
  ],
  "signatureFeatures": [
    "Reference Blink/V8 engine",
