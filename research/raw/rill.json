  "pitch": "WebKit Mac browser that hands pages to your Claude Code or Codex agent.",
  "summary": "Native Mac WebKit browser built around coding agents: press ⌘E on any page to turn it into a task for Claude Code or Codex, track parallel agent projects, and organize tabs by theme. Free, no new subscription.",
  "bestFor": [
    "Developers who already pay for Claude Code or Codex",
    "Mac users wanting agents as first-class citizens",
    "People who prefer WebKit and Keychain"
  ],
  "notFor": [
    "Non-Mac users",
    "Chrome-extension users (not supported yet)",
    "People who want a stand-alone cloud agent"
  ],
  "pros": [
    {
      "title": "Agents beside the page",
      "detail": "⌘E sends page context to Claude Code or Codex while you keep browsing."
    },
    {
      "title": "No new subscription",
      "detail": "Uses your existing Claude Code or Codex plan; no API keys."
    },
    {
      "title": "Keychain passwords",
      "detail": "Saves to the Mac Keychain; 1Password works via universal autofill."
    },
    {
      "title": "Free",
      "detail": "No charge."
    }
  ],
  "cons": [
