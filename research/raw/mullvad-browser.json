  "faq": [
    {
      "q": "Is it the same as Tor Browser?",
      "a": "No: it has the same hardening but does not route traffic through Tor."
    },
    {
      "q": "Does it need Mullvad VPN?",
      "a": "No, but it is designed to be used with a VPN; it works without one."
    },
    {
      "q": "Is it still on ESR?",
      "a": "Stable 15.x is on Firefox ESR 140; the 16 alpha moved toward newer Firefox bases."
    }
