  "pros": [
    {
      "title": "Uniform fingerprint",
      "detail": "Shares Tor Browser's resist-fingerprinting and letterboxing work."
    },
    {
      "title": "uBlock Origin included",
      "detail": "Stable 15.0.24 ships uBO 1.75.0 and NoScript."
    },
    {
      "title": "No telemetry",
      "detail": "Mullvad collects no usage data; open source."
    },
    {
      "title": "Normal speed",
      "detail": "No onion routing, so page loads are close to ordinary Firefox."
    },
    {
      "title": "Regular security releases",
      "detail": "Updated on the same cadence as Tor Browser (15.0.26 on Oct 21, 2026)."
    }
  ],
  "cons": [
    {
      "title": "Desktop only",
      "detail": "No Android or iOS versions."
    },
    {
      "title": "No sync or passwords",
      "detail": "Intentionally omits persistent profile features."
    },
    {
      "title": "No DRM",
      "detail": "Widevine is not available."
    },
    {
      "title": "Not anonymous alone",
      "detail": "IP is not hidden unless you pair with a VPN or Tor."
    }
  ],
