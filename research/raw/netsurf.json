  "pitch": "Tiny graphical browser with its own engine, from RISC OS to Linux. Modern sites break.",
  "summary": "A small, fast, free browser written in C with its own HTML/CSS engine and Duktape JavaScript. It runs on RISC OS, Amiga, Haiku and Linux, but handles only older web standards, so many modern sites fail.",
  "bestFor": [
    "Retro and niche systems (RISC OS, AmigaOS, Haiku, Atari)",
    "Very low-spec machines that cannot run a mainstream browser",
    "Reading static, standards-based pages with minimal resource use"
  ],
  "notFor": [
    "Anyone who needs modern web apps, video or heavy JavaScript",
    "People who want extensions, sync or a password manager",
    "Users who need strong security hardening or fast patches"
  ],
  "pros": [
    {
      "title": "Very small and quick",
      "detail": "Its own engine in C: the RISC OS build is 4.0 MB and the AmigaOS build 6.9 MB (per Wikipedia)."
    },
    {
      "title": "Runs where others do not",
      "detail": "Official ports for RISC OS, AmigaOS 4, Haiku/BeOS, Atari, Linux and Windows; third-party ports to MorphOS, Plan 9 and more."
    },
    {
      "title": "Own standards stack",
      "detail": "Hubbub HTML5 parser, LibCSS, LibDOM and Duktape JavaScript, with CSS flex added in 3.11."
    },
    {
      "title": "No telemetry",
      "detail": "A volunteer project with no business model and no data-collection service."
    },
    {
      "title": "Still receiving commits",
      "detail": "The git mirror shows daily commits in late October 2026, including HSTS test work."
    }
  ],
  "cons": [
    {
      "title": "Weak modern-web support",
      "detail": "Targets HTML 4.01 and CSS 2.1 plus selected newer features; JavaScript is limited, so web apps usually fail."
    },
    {
      "title": "No media or web apps",
      "detail": "Renders images (PNG, JPEG, GIF, SVG, WebP, JPEG XL) but not modern video or canvas-style apps."
    },
    {
      "title": "Thin security model",
      "detail": "C codebase without sandboxing or site isolation; fixes depend on volunteers."
    },
    {
      "title": "Slow releases, no polished Windows build",
      "detail": "Stable releases are years apart, and there is no complete native Windows port (the GTK front end is built for Windows)."
    }
  ],
  "signatureFeatures": [
    "Own HTML/CSS engine",
    "Tiny footprint",
    "RISC OS / Amiga / Haiku ports",
    "Duktape JavaScript"
  ],
  "faq": [
    {
      "q": "Does NetSurf support JavaScript?",
      "a": "Yes, in a limited form via the Duktape engine (since 2015), but coverage is far below mainstream browsers; the project does not publish a compatibility level."
    },
    {
      "q": "Is NetSurf still maintained?",
      "a": "Yes, slowly. The latest stable release is 3.11 (28 Dec 2023), and the git mirror had commits on 28 Oct 2026."
    },
    {
      "q": "Why does my favourite site not work?",
      "a": "NetSurf implements HTML 4.01 and CSS 2.1 plus newer pieces like flexbox and media queries; sites built on heavy JavaScript frameworks are out of reach."
    }
  ],
