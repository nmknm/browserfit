  "pitch": "Anonymity-first browser that routes everything through Tor and blends all users together.",
  "summary": "Hardened Firefox ESR that sends all traffic through the Tor network with uniform fingerprints, first-party isolation and no telemetry. Desktop and Android; slow by design.",
  "bestFor": [
    "Journalists, activists and anyone needing network anonymity",
    "Accessing .onion services",
    "Bypassing censorship with bridges and Snowflake"
  ],
  "notFor": [
    "Everyday fast browsing and streaming",
    "Logging into personal accounts",
    "People who want sync or heavy customisation"
  ],
  "pros": [
    {
      "title": "Network anonymity",
      "detail": "All traffic goes over three-hop Tor circuits, hiding your IP from sites."
    },
    {
      "title": "Uniform fingerprint",
      "detail": "Letterboxing and resistFingerprinting make users look alike."
    },
    {
      "title": "Per-site isolation",
      "detail": "First-party isolation and New Identity wipe state and circuits."
    },
    {
      "title": "Zero telemetry",
      "detail": "No analytics; non-profit and fully open source."
    },
    {
      "title": "Censorship circumvention",
      "detail": "Built-in bridges, Snowflake and Lyrebird transports."
    },
    {
      "title": "Prompt security fixes",
      "detail": "Tracks Firefox ESR with emergency releases such as 15.0.26 (Oct 2026)."
    }
  ],
  "cons": [
    {
      "title": "Slow",
      "detail": "Three-hop routing makes pages and downloads noticeably slower."
    },
    {
      "title": "Site breakage",
      "detail": "Many sites block Tor exits or serve CAPTCHAs; streaming does not work."
    },
    {
      "title": "No iOS version",
      "detail": "Apple rules forbid it; Tor recommends Onion Browser instead."
    },
    {
      "title": "Not a daily driver",
      "detail": "No sync, no passwords, no media DRM, minimal customisation."
    }
  ],
  "signatureFeatures": [
    "Tor circuits",
    "Letterboxing",
    "New Identity",
    "Snowflake bridges",
    "NoScript security levels"
  ],
  "faq": [
    {
      "q": "Is Tor Browser available on iPhone?",
      "a": "No official build; Tor Project points to Onion Browser, which uses WebKit and gets weaker protections."
    },
    {
      "q": "Should I add extensions?",
      "a": "The Tor Project discourages it because extra add-ons make your fingerprint unique."
    },
    {
      "q": "Is it based on Firefox?",
      "a": "Yes, Firefox ESR 140 in the stable 15.0 line; the 16 alpha moves to ESR 153."
    }
  ],
