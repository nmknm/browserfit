  "pitch": "Amazon’s browser for Fire tablets, Fire TV and Echo Show, built on Chromium.",
  "summary": "Silk is the default browser on Amazon’s Fire devices. It began in 2011 with a cloud-accelerated split-browser design and is now a Chromium-based browser with Alexa control, private tabs and Amazon account backup.",
  "bestFor": [
    "Fire tablet and Fire TV owners",
    "Casual browsing on Amazon devices",
    "Voice control through Alexa"
  ],
  "notFor": [
    "People who need extensions, ad blocking or a password manager",
    "Anyone who wants strong privacy defaults"
  ],
  "pros": [
    {
      "title": "Built into Fire devices",
      "detail": "Preinstalled on Fire tablets, Fire TV and Echo Show."
    },
    {
      "title": "Current Chromium base",
      "detail": "Version 152 uses Chromium 152, so modern sites work."
    },
    {
      "title": "Alexa voice control",
      "detail": "Alexa and the Fire TV remote can control video and music."
    },
    {
      "title": "Private tabs and local history",
      "detail": "History is stored on the device and can be cleared."
    }
  ],
  "cons": [
    {
      "title": "No extensions or ad blocker",
      "detail": "Amazon’s docs say Silk has no add-on support and no built-in ad blocking."
    },
    {
      "title": "Amazon account tie-in",
      "detail": "Optional customised recommendations send browsing history to Amazon."
    },
    {
      "title": "Closed and device-bound",
      "detail": "Proprietary, and mainly useful on Amazon hardware."
    }
  ],
  "signatureFeatures": [
    "Fire TV remote navigation",
    "Alexa voice control",
    "Private tabs",
    "Cloud backup of bookmarks"
  ],
  "faq": [
    {
      "q": "Does Silk still use Amazon’s cloud to speed up pages?",
      "a": "The original 2011 split-browser design did, with an option to turn it off; current docs describe a Chromium-based browser."
    },
    {
      "q": "Can I install ad blockers in Silk?",
      "a": "No. Amazon says Silk does not support extensions or add-ons."
    },
    {
      "q": "Does Silk sync history?",
      "a": "Fire tablets can back up settings and bookmarks to the Amazon cloud; full sync is not documented officially."
    }
  ],
