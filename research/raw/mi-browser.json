  "faq": [
    {
      "q": "What happened with Mi Browser and incognito mode?",
      "a": "In April 2020 Forbes reported Mi Browser and Mi Browser Pro sent browsing data, including incognito, to Xiaomi servers; Xiaomi added an opt-out button by May 4, 2020."
    },
    {
      "q": "How do I disable ads in Mi Browser?",
      "a": "Turn off Show ads, recommended news and personalised services in Mi Browser settings, and disable MSA/personalised ads in system Privacy settings."
    },
    {
      "q": "Is it on Google Play?",
      "a": "Yes, as Mi Browser Pro (com.mi.globalbrowser, updated 2026-10-15)."
    }
  ],
