  "pitch": "KDE’s lightweight Qt browser with built-in ad blocking and a speed-dial.",
  "summary": "Falkon is the KDE project’s Qt WebEngine browser (the former QupZilla). It offers built-in ad blocking, a password manager integration and Python/QML plugins, but ships few headline features and has no extension store or sync.",
  "bestFor": [
    "KDE Plasma desktops",
    "People wanting a simple Chromium-engine browser without Google services",
    "Light use on Linux or Windows"
  ],
  "notFor": [
    "People who need Chrome/Firefox extensions",
    "Cross-device sync users",
    "Anyone who needs fast Chromium patching"
  ],
  "pros": [
    {
      "title": "Built-in ad blocking",
      "detail": "ABP-style filter lists included without extensions."
    },
    {
      "title": "KDE integration",
      "detail": "Uses KDE wallets, themes and dialogs; follows Plasma look."
    },
    {
      "title": "Light and simple",
      "detail": "Clean interface, speed dial, full-page screenshots."
    },
    {
      "title": "Open and independent",
      "detail": "GPL-3.0, no telemetry or accounts."
    }
  ],
  "cons": [
    {
      "title": "No WebExtensions",
      "detail": "Plugins are Falkon-specific (Python/QML/C++), so the ecosystem is tiny."
    },
    {
      "title": "No sync",
      "detail": "No built-in cross-device sync of bookmarks or tabs."
    },
    {
      "title": "Slow patch pipeline",
      "detail": "Chromium fixes arrive via Qt WebEngine releases and distro packaging."
    },
    {
      "title": "Low development velocity",
      "detail": "KDE Gear 26.08 changelogs show only maintenance changes for Falkon."
    }
  ],
  "signatureFeatures": [
    "Built-in AdBlock",
    "Speed dial",
    "KDE integration",
    "Python/QML plugins"
  ],
  "faq": [
    {
      "q": "Is Falkon based on Chromium?",
      "a": "Yes, through Qt WebEngine; Falkon itself is a Qt/C++ application."
    },
    {
      "q": "Does Falkon support Chrome extensions?",
      "a": "No. It has its own plugin system; Chrome Web Store extensions do not install."
    },
    {
      "q": "Is Falkon available on Windows?",
      "a": "Yes, KDE publishes Windows builds (Microsoft Store/CI), though Linux is the main platform."
    }
  ],
