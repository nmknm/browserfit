  "pitch": "The built-in Quest headset browser: Chromium with WebXR, WebGPU and spatial windows.",
  "summary": "Meta’s Chromium-based browser for Quest headsets on Horizon OS. It is the main way to run WebXR content on Quest, and it adds spatial features such as wall-anchored windows and tabs inside immersive apps.",
  "bestFor": [
    "Quest owners browsing the web or watching video in a headset",
    "WebXR developers testing on real hardware",
    "Viewing 360° and immersive video"
  ],
  "notFor": [
    "People who want a privacy-first or ad-blocking browser",
    "Anyone who needs a desktop-class extension ecosystem",
    "Users on non-Meta headsets"
  ],
  "pros": [
    {
      "title": "WebXR first",
      "detail": "WebXR has been on by default since v7.0, with hand and body tracking and WebGPU added later."
    },
    {
      "title": "Spatial windowing",
      "detail": "Draggable tabs, wall-anchored windows on Quest 3 and later, and tabs usable inside immersive apps."
    },
    {
      "title": "Modern Chromium",
      "detail": "Tracks recent Chromium milestones, so current web apps and sites run."
    },
    {
      "title": "Extensions",
      "detail": "Selected extensions have been supported since v32.2 (April 2024)."
    }
  ],
  "cons": [
    {
      "title": "Quest only",
      "detail": "Ships on Meta headsets and is not available elsewhere."
    },
    {
      "title": "Closed source",
      "detail": "Only the Chromium base is open; Meta’s changes are not."
    },
    {
      "title": "Weak privacy tooling",
      "detail": "No built-in tracker or ad blocking documented; telemetry has an opt-out."
    }
  ],
  "signatureFeatures": [
    "WebXR with hand tracking",
    "WebGPU",
    "Wall-anchored windows",
    "Tabs inside immersive apps"
  ],
  "faq": [
    {
      "q": "Is Meta Quest Browser the same as Oculus Browser?",
      "a": "Yes. Meta renamed Oculus Browser to Meta Quest Browser in January 2024."
    },
    {
      "q": "What engine does it use?",
      "a": "Blink and V8 from Chromium."
    },
    {
      "q": "Can I use another browser on Quest?",
      "a": "Yes, for example Wolvic, which is available from the Meta store and as an APK."
    }
  ],
