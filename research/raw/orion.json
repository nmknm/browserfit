  "faq": [
    {
      "q": "What happened to Orion for Linux and Windows?",
      "a": "Kagi ended its development on 2026-10-02; the Linux beta keeps working without updates and the source is to be open-sourced for the community."
    },
    {
      "q": "Is Orion free?",
      "a": "Yes; Orion+ is an optional paid tier ($5/mo, $50/yr, $150 lifetime)."
    },
    {
      "q": "Does Orion use Chromium?",
      "a": "No. It is WebKit-based on macOS and iOS (WebKitGTK on the Linux beta)."
    }
