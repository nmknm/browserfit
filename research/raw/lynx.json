  "pitch": "The original text-mode web browser: no images, no JavaScript, tiny and fast.",
  "summary": "Lynx renders HTML as text in a terminal, with no JavaScript, images or CSS. It is ideal for SSH sessions, screen readers and low-end systems, but cannot use most modern web apps.",
  "bestFor": [
    "Terminal and SSH-only environments",
    "Braille display and screen-reader users",
    "Scripting page dumps (-dump, -source)",
    "Very old or tiny hardware"
  ],
  "notFor": [
    "Anyone needing JavaScript, images or video",
    "Logging into modern web apps",
    "Beginners expecting a point-and-click UI"
  ],
  "pros": [
    {
      "title": "Tiny and instant",
      "detail": "Starts immediately and uses a few MB of RAM, even on very old hardware."
    },
    {
      "title": "No JavaScript attack surface",
      "detail": "No JS, no CSS tracking tricks and no images means most tracking and ads never load."
    },
    {
      "title": "Accessibility friendly",
      "detail": "Plain linear text output works well with braille displays and screen readers."
    },
    {
      "title": "Scriptable",
      "detail": "Dump or fetch pages from the command line and customise keys through lynx.cfg."
    },
    {
      "title": "Everywhere",
      "detail": "Packaged in nearly every Linux/BSD distro and Homebrew, with Windows builds by the maintainer."
    }
  ],
  "cons": [
    {
      "title": "Most modern sites fail",
      "detail": "No JavaScript means web apps, logins with JS flows and SPAs generally do not work."
    },
    {
      "title": "No images or media",
      "detail": "Cannot display images or video itself, only hand them to external programs."
    },
    {
      "title": "Dated interface",
      "detail": "Cursor-key link navigation and a config file are a steep learning curve for newcomers."
    },
    {
      "title": "Small security surface but old code",
      "detail": "C codebase without modern sandboxing; TLS stack depends on OpenSSL/GnuTLS builds."
    }
  ],
  "signatureFeatures": [
    "Numbered-link navigation",
    "Page dump / source mode",
    "lynx.cfg and keymap customisation",
    "Cookie accept/reject prompts"
  ],
  "faq": [
    {
      "q": "Does Lynx support JavaScript?",
      "a": "No. It never has and is not planned; sites that require JavaScript will not work."
    },
    {
      "q": "Is Lynx still maintained?",
      "a": "Yes. Thomas Dickey released 2.9.3 on 2026-05-27, including zstd content-encoding support."
    },
    {
      "q": "Can Lynx show images?",
      "a": "Not itself; it can launch external viewers for images and other media."
    }
  ],
