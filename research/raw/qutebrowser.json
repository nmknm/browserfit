  "pitch": "Vim-style keyboard-driven browser with a minimal GUI, on Qt WebEngine.",
  "summary": "qutebrowser is a Python/Qt browser controlled with vim-like keys, a command line and hints. It is deeply configurable through config.py and userscripts, but is limited by Qt WebEngine and has no extension store, sync or mobile app.",
  "bestFor": [
    "Vim users who want a keyboard-only browser",
    "People who like to configure everything in a text file",
    "Tiling-WM users who want minimal chrome"
  ],
  "notFor": [
    "People who rely on browser extensions or sync",
    "Mobile or cross-device users",
    "Anyone who needs strict Chromium-level patch timing"
  ],
  "pros": [
    {
      "title": "True keyboard workflow",
      "detail": "Hints, modes, a command line and vim-like bindings cover almost everything without a mouse."
    },
    {
      "title": "Deep configuration",
      "detail": "config.py plus per-domain settings, custom CSS and userscripts allow fine control."
    },
    {
      "title": "Built-in ad blocking",
      "detail": "Supports ABP-style filter lists, using Brave adblock via python-adblock when installed, plus host blocking."
    },
    {
      "title": "Modern rendering",
      "detail": "Qt WebEngine means current Chromium-class compatibility and DevTools."
    },
    {
      "title": "No telemetry",
      "detail": "Independent volunteer project with no tracking or accounts."
    }
  ],
  "cons": [
    {
      "title": "No extensions",
      "detail": "No WebExtensions; only Greasemonkey-style userscripts and external scripts."
    },
    {
      "title": "No sync or password manager",
      "detail": "Relies on userscripts for Bitwarden/pass/KeePassXC; no built-in sync."
    },
    {
      "title": "Qt WebEngine lag",
      "detail": "Security fixes depend on Qt releases and distro packaging, which can trail Chrome."
    },
    {
      "title": "Steep learning curve",
      "detail": "Modal keybindings are unfamiliar to non-vim users."
    }
  ],
  "signatureFeatures": [
    "Link hints",
    "Vim-style modal keys",
    "config.py and :set",
    "Userscripts and per-domain settings"
  ],
  "faq": [
    {
      "q": "Does qutebrowser support Chrome or Firefox extensions?",
      "a": "No. It supports Greasemonkey-style userscripts and external scripts, not WebExtensions."
    },
    {
      "q": "What engine does qutebrowser use?",
      "a": "Qt WebEngine, which is Chromium-based. The old QtWebKit backend was removed."
    },
    {
      "q": "Is there a Windows or macOS build?",
      "a": "Yes, official builds exist; the 3.7.0 Windows/macOS releases ship Qt 6.11.0."
    }
  ],
