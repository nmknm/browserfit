  "pitch": "Chromium with Google web services and tracking code removed.",
  "summary": "A patch set that strips Google integration and telemetry from Chromium. No sync, no blocker bundled, no auto-updater; binaries mostly from community sources.",
  "bestFor": [
    "Chromium users who want no Google calls",
    "Linux users who like patch-set transparency",
    "People who want Chromium behaviour without Google services"
  ],
  "notFor": [
    "People wanting automatic updates",
    "Users needing sync or built-in blocking",
    "Streaming users (no Widevine)"
  ],
  "pros": [
    {
      "title": "No Google services",
      "detail": "Removes Google API keys, Safe Browsing, sync and telemetry calls."
    },
    {
      "title": "Chromium compatibility",
      "detail": "Same engine and DevTools as Chromium."
    },
    {
      "title": "Transparent patches",
      "detail": "All changes are open on GitHub under BSD-3."
    },
    {
      "title": "Fast upstream tracking (Linux)",
      "detail": "156.0.8078.73-1 shipped on Oct 28, 2026, days after Chromium 156."
    },
    {
      "title": "Flexible flags",
      "detail": "Adds extra privacy flags and runtime switches."
    }
  ],
  "cons": [
    {
      "title": "No auto-update",
      "detail": "Updating is manual or via a package manager; Windows builds lagged on 155.0.8059.84."
    },
    {
      "title": "No built-in blocking",
      "detail": "Needs uBlock Origin Lite or similar; MV2 uBO unavailable on current Chromium."
    },
    {
      "title": "No sync or Widevine",
      "detail": "No cross-device sync and no DRM out of the box."
    },
    {
      "title": "Rough edges",
      "detail": "No official installer; Chrome Web Store access requires a helper extension."
    }
  ],
  "signatureFeatures": [
    "Google-free Chromium",
    "No Safe Browsing pings",
    "Patch-based transparency",
    "Extra privacy flags"
  ],
  "faq": [
    {
      "q": "Is it safer than Chrome?",
      "a": "It strips Google services but you lose Safe Browsing and auto-update, so security depends on updating promptly."
    },
    {
      "q": "Does uBlock Origin work?",
      "a": "The MV2 uBO does not run on current Chromium; uBlock Origin Lite (MV3) works."
    },
    {
      "q": "Where do I get Windows builds?",
      "a": "From the project's listed community binaries; recent Windows build found was 155.0.8059.84-1.1."
    }
  ],
