  "pitch": "Privacy-first Firefox ESR fork with native tree tabs and legacy add-on support.",
  "summary": "Independent Firefox ESR fork. Waterfox 6.7 (Aug 2026) moved to ESR 153 with native tree-style vertical tabs, a built-in ad blocker panel, 12 palettes, restored legacy add-ons, no telemetry and AI disabled.",
  "bestFor": [
    "Firefox users who want fewer Mozilla extras",
    "People who want vertical tree tabs without an extension",
    "Users who want no AI and no telemetry"
  ],
  "notFor": [
    "People who want Firefox-level resources behind security patching",
    "Those who need a polished mobile app",
    "Anyone wanting workspaces or split view"
  ],
  "pros": [
    {
      "title": "No telemetry, no AI",
      "detail": "Zero telemetry, Safe Browsing endpoints disabled, Firefox 153 AI features turned off by default."
    },
    {
      "title": "Native tree-style tabs",
      "detail": "Vertical tab strip with built-in tree support in 6.7, replacing the bundled add-on."
    },
    {
      "title": "Legacy add-on support",
      "detail": "Restores restartless, overlay and restart-required add-ons alongside WebExtensions."
    },
    {
      "title": "Built-in ad blocker",
      "detail": "6.7 adds a dedicated blocker settings panel."
    },
    {
      "title": "Android app",
      "detail": "Waterfox for Android (1.2.10, Gecko 159) is on Google Play."
    }
  ],
  "cons": [
    {
      "title": "Behind on new Firefox features",
      "detail": "ESR base means feature updates arrive only with the yearly rebase."
    },
    {
      "title": "Small team",
      "detail": "Security patching depends on a small company shipping on top of Mozilla."
    },
    {
      "title": "Fewer tab-management tools",
      "detail": "No workspaces or split view like Zen or Vivaldi."
    },
    {
      "title": "Mixed Android reviews",
      "detail": "Play rating about 3.5 from ~3.3k ratings (AppBrain)."
    }
  ],
  "signatureFeatures": [
    "Native tree-style vertical tabs",
    "Legacy add-on support",
    "Built-in ad blocker panel",
    "No telemetry, AI off",
    "Nova style and 12 palettes"
  ],
  "faq": [
    {
      "q": "Does Waterfox have AI?",
      "a": "The Firefox 153 AI features are disabled by default and 6.7.4 added a switch to disable AI in search results."
    },
    {
      "q": "Is Waterfox on Android?",
      "a": "Yes, Waterfox for Android is on Google Play (1.2.10, Gecko 159 as of late October 2026)."
    },
    {
      "q": "Which Firefox is it based on?",
      "a": "Waterfox 6.7 is built on Firefox ESR 153, up from ESR 140."
    }
  ],
