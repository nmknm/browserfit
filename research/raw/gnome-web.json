  "pitch": "GNOME’s simple WebKitGTK browser with web-app mode and ITP-style protection.",
  "summary": "GNOME Web (Epiphany) is a clean GTK4/libadwaita browser on WebKitGTK. It has built-in ad blocking, web-app mode and Keyring integration, but minimal extensions, no working sync since GNOME 47, and Linux-only availability.",
  "bestFor": [
    "GNOME desktop users",
    "Linux phones and small screens (adaptive UI)",
    "People who want a simple, low-tracking browser"
  ],
  "notFor": [
    "Extension users",
    "Netflix/DRM users",
    "Cross-device sync"
  ],
  "pros": [
    {
      "title": "GNOME-native",
      "detail": "GTK4/libadwaita UI, GNOME Keyring and Wayland support."
    },
    {
      "title": "Web apps",
      "detail": "Install any site as a standalone launcher."
    },
    {
      "title": "Built-in protection",
      "detail": "WebKit content-blocker ad blocking, Intelligent Tracking Prevention and Safe Browsing."
    },
    {
      "title": "Sandboxed",
      "detail": "Uses Bubblewrap sandboxing for tab processes."
    },
    {
      "title": "Zero telemetry",
      "detail": "GNOME project with no accounts or tracking."
    }
  ],
  "cons": [
    {
      "title": "Almost no extensions",
      "detail": "Experimental WebExtensions in GNOME 43/44 only; the old extension package was removed."
    },
    {
      "title": "Sync disabled",
      "detail": "Firefox Sync support was disabled in GNOME 47 after Mozilla’s changes."
    },
    {
      "title": "WebKitGTK compatibility",
      "detail": "Some sites break compared with Blink; no mainstream DRM."
    },
    {
      "title": "Linux only",
      "detail": "No Windows/macOS/Android builds."
    }
  ],
  "signatureFeatures": [
    "Web Application mode",
    "Intelligent Tracking Prevention",
    "Reader mode",
    "Adaptive mobile UI"
  ],
  "faq": [
    {
      "q": "Does GNOME Web sync with Firefox?",
      "a": "No. Firefox Sync was supported from GNOME 3.26 to 47 but was disabled in GNOME 47."
    },
    {
      "q": "Can I use Chrome or Firefox extensions?",
      "a": "No. Only an experimental subset of WebExtensions exists, and there is no add-on store."
    },
    {
      "q": "Does it support passkeys?",
      "a": "I could not confirm; one GNOME 51 guide claims passkey support, but this is not corroborated."
    }
  ],
