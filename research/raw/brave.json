  "pitch": "Chromium with strong built-in blocking and optional extras; Origin strips the extras.",
  "summary": "Chromium-based browser with Shields blocking, fingerprint farbling, Tor windows, sync chain, and optional Leo AI, Rewards and VPN. Brave Origin (2026) is a paid stripped-down edition.",
  "bestFor": [
    "People who want blocking and privacy with zero setup",
    "Chrome users who want to keep Chromium compatibility",
    "Users who want to keep uBO-style MV2 blockers on a Chromium engine",
    "Users who want a Chromium browser without Google services"
  ],
  "notFor": [
    "People who dislike crypto, AI and promo extras (unless they buy Origin)",
    "Users who want a non-Chromium engine",
    "Those wanting Tor-grade anonymity"
  ],
  "pros": [
    {
      "title": "Blocking by default",
      "detail": "Shields blocks ads, trackers, third-party cookie tracking and upgrades HTTPS with no setup."
    },
    {
      "title": "Fingerprint farbling",
      "detail": "Randomises fingerprint surfaces per session and eTLD+1 rather than a single fixed value."
    },
    {
      "title": "Chromium compatibility",
      "detail": "Chrome Web Store extensions and near-perfect site compatibility."
    },
    {
      "title": "Partial MV2 survival",
      "detail": "Keeps self-hosted MV2 builds of uBO, AdGuard, uMatrix and NoScript working after Chrome removed MV2."
    },
    {
      "title": "E2EE sync chain",
      "detail": "Sync needs no account, just a sync code, and is end-to-end encrypted."
    },
    {
      "title": "Fast Chromium patching",
      "detail": "Ships Chromium security point releases within days (1.97.57 and 1.97.59 in Oct 2026)."
    }
  ],
  "cons": [
    {
      "title": "Bundled extras",
      "detail": "Rewards, Wallet, VPN upsells, News and Leo are present unless you disable them or pay for Origin."
    },
    {
      "title": "Past controversies",
      "detail": "Affiliate-link injection (2020) and the crypto-ads model reduced trust for some users."
    },
    {
      "title": "Mobile extension gap",
      "detail": "Android extension support is still experimental behind a flag; iOS has none."
    },
    {
      "title": "Chromium monoculture",
      "detail": "Same engine as Chrome and Edge, so engine diversity is not improved."
    }
  ],
  "signatureFeatures": [
    "Shields",
    "Tor private windows",
    "Brave Search",
    "Leo AI",
    "Brave Origin"
  ],
  "faq": [
    {
      "q": "Is Brave still usable with uBlock Origin?",
      "a": "Partly: Brave keeps self-hosted MV2 builds of uBO, AdGuard, uMatrix and NoScript working, but the Chrome Web Store no longer lists MV2 extensions. Its built-in Shields covers most blocking needs anyway."
    },
    {
      "q": "What is Brave Origin?",
      "a": "A 2026 paid edition ($59.99 one-time, 10 devices, Linux free) that removes Rewards, Wallet, VPN promos, Leo, News and sponsored images while keeping Shields."
    },
    {
      "q": "Does Brave support extensions on Android?",
      "a": "Not yet for normal users; work started in Sept-Oct 2026 behind brave://flags/#brave-android-extensions, Canary first."
    }
  ],
