  "pros": [
    {
      "title": "Free on all platforms",
      "detail": "Paywall dropped Oct 2025; desktop and mobile apps are free to download."
    },
    {
      "title": "Desktop and mobile",
      "detail": "Windows, macOS, Android (Nov 2025) and iOS (Mar 2026)."
    },
    {
      "title": "Strong research assistant",
      "detail": "Perplexity answers and agent actions available in a sidebar on any page."
    },
    {
      "title": "Chrome extension compatibility",
      "detail": "Installs from the Chrome Web Store via \"Add to Comet\" (MV3)."
    },
    {
      "title": "Enterprise option",
      "detail": "Comet for Enterprise can be deployed through MDM."
    }
  ],
  "cons": [
    {
      "title": "Prompt-injection concerns",
      "detail": "CometJacking and other disclosed attacks showed agent data-exfiltration risks."
    },
    {
      "title": "Cloud-only AI",
      "detail": "Page content and prompts go to Perplexity servers; no local model option."
    },
    {
      "title": "No Linux build",
      "detail": "Only Windows, macOS, Android and iOS."
    },
    {
      "title": "Best features paywalled",
      "detail": "Higher usage limits and the Computer feature need Pro/Max subscriptions."
    }
  ],
  "signatureFeatures": [
    "Comet Assistant",
    "Agentic task running",
    "Perplexity search integration",
    "Android and iOS apps"
  ],
  "faq": [
    {
      "q": "Is Comet free?",
      "a": "Yes, the browser has been free since Oct 2, 2025; paid Perplexity plans only raise AI limits and unlock extras."
    },
    {
      "q": "Which platforms does it support?",
      "a": "Windows 10+, macOS, Android 12+ and iOS 18+; no Linux build."
    },
    {
      "q": "Does it support Chrome extensions?",
      "a": "Yes via the Chrome Web Store, but only MV3; full uBlock Origin is unavailable."
    }
  ],
