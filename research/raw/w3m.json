  "pitch": "Text-mode browser and pager with tables, tabs and optional inline images.",
  "summary": "w3m is a terminal browser that renders tables and frames, supports tabs, and can show inline images in capable terminals. Like Lynx it has no JavaScript, and upstream is largely inactive with forks carrying on.",
  "bestFor": [
    "Terminal users who want tabs and table rendering",
    "Use as a pager/HTML viewer (mutt, Emacs w3m)",
    "SSH-only systems"
  ],
  "notFor": [
    "Anything needing JavaScript",
    "Users who need an actively maintained, security-audited browser"
  ],
  "pros": [
    {
      "title": "Better layout than Lynx",
      "detail": "Renders tables and frames in text, with tabs and mouse support."
    },
    {
      "title": "Inline images",
      "detail": "With w3m-img and a suitable terminal it can display images inline."
    },
    {
      "title": "Great as a pager",
      "detail": "Pipes HTML or text through it, and integrates with Emacs (emacs-w3m)."
    },
    {
      "title": "Tiny and fast",
      "detail": "Minimal RAM and instant startup."
    }
  ],
  "cons": [
    {
      "title": "Upstream inactive",
      "detail": "Original project stalled; there are competing forks, so patch speed is uncertain."
    },
    {
      "title": "No JavaScript",
      "detail": "Modern sites and logins largely fail."
    },
    {
      "title": "Security history",
      "detail": "Memory-safety bugs have been reported in the C code base over the years."
    }
  ],
  "signatureFeatures": [
    "Tabs in a terminal",
    "Table and frame rendering",
    "Inline image display (w3m-img)",
    "Emacs integration"
  ],
  "faq": [
    {
      "q": "Is w3m still maintained?",
      "a": "The original project is not, but forks exist; Wikipedia lists 0.5.6 as of 2026-01-23 and a SourceHut fork still in development."
    },
    {
      "q": "Does w3m support JavaScript?",
      "a": "No."
    },
    {
      "q": "Can w3m show images?",
      "a": "Yes in supported terminals, usually via the separate w3m-img package."
    }
  ],
