  "pitch": "Tencent's Chinese-market browser with PDF tools, WeChat tie-ins and agentic AI.",
  "summary": "QQ Browser is Tencent's Chromium-based browser, widely used in China, with document/PDF tools, video features and, since April 2026, the QBotClaw agent that automates tasks and can be driven from WeChat.",
  "bestFor": [
    "Users in mainland China wanting Tencent/WeChat integration",
    "People who want built-in document/PDF handling",
    "Early adopters of agentic browsing"
  ],
  "notFor": [
    "Privacy-conscious users",
    "Users outside China needing English polish",
    "Anyone who dislikes feeds and ads"
  ],
  "pros": [
    {
      "title": "QBotClaw agent",
      "detail": "Natural-language automation (e.g. price comparisons across Taobao and JD) launched April 2026, remote-controllable from WeChat."
    },
    {
      "title": "Tencent ecosystem",
      "detail": "Deep integration with WeChat, QQ and Tencent Docs."
    },
    {
      "title": "Built-in tools",
      "detail": "Document, PDF, video and screenshot utilities are bundled."
    },
    {
      "title": "Broad platform coverage",
      "detail": "Windows, macOS, Android and iOS."
    }
  ],
  "cons": [
    {
      "title": "Security history",
      "detail": "Citizen Lab (2016) found insecure data transmission and unsafe update mechanisms in Windows and Android versions."
    },
    {
      "title": "Ad and feed heavy",
      "detail": "Start page feeds and promotions are central to the model."
    },
    {
      "title": "Early agent limits",
      "detail": "Hands-on test hit API rate limits and needed manual logins."
    },
    {
      "title": "Opaque versions",
      "detail": "Current build and Chromium base not published in an easy-to-verify place."
    }
  ],
  "signatureFeatures": [
    "QBotClaw AI agent",
    "PDF/doc tools",
    "WeChat integration",
    "Video player and downloader"
  ],
  "faq": [
    {
      "q": "Does QQ Browser have an AI agent?",
      "a": "Yes. Tencent Cloud announced QBotClaw on 2026-04-08; Mac was live first and Windows was \"coming soon\" at launch."
    },
    {
      "q": "Is it Chromium-based?",
      "a": "Wikipedia describes Chromium-based engine upgrades since version 9.0 (2015); the current Chromium version is not published in sources found."
    },
    {
      "q": "Is QQ Browser private?",
      "a": "Not by default. Citizen Lab reported insecure data handling in 2016, and it is a Tencent ad/content product."
    }
  ],
