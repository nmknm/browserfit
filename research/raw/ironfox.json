  "pitch": "Hardened, telemetry-free Firefox for Android, continuing the Mull project.",
  "summary": "Community Firefox fork for Android that continues Mull: Mozilla telemetry stripped, strict tracking protection, content blocking on by default, Fission site isolation. Not on Google Play: use Accrescent, its F-Droid repo or Obtainium.",
  "bestFor": [
    "Android users wanting a hardened Firefox with no Google services",
    "Former Mull or DivestOS users",
    "People who install via Accrescent/F-Droid/Obtainium"
  ],
  "notFor": [
    "People who want one-tap Google Play installs",
    "Those who want maximum site compatibility",
    "Users wanting a big, long-established team"
  ],
  "pros": [
    {
      "title": "Mull successor",
      "detail": "Carries all of Mull's privacy patches and adds more from the Phoenix project."
    },
    {
      "title": "Telemetry stripped",
      "detail": "Removes Mozilla data-collection hooks and services like Pocket while keeping E2EE sync."
    },
    {
      "title": "Blocking on by default",
      "detail": "Reviews report built-in content blocking and strict tracking protection."
    },
    {
      "title": "Secure install options",
      "detail": "Accrescent recommended, signing certificate fingerprint published, Obtainium supported."
    },
    {
      "title": "Fully open source",
      "detail": "Developed on GitLab with GitHub and Codeberg mirrors."
    }
  ],
  "cons": [
    {
      "title": "Not on Google Play",
      "detail": "Install needs Accrescent, F-Droid repo, Obtainium or APK; no official F-Droid inclusion (project declines it)."
    },
    {
      "title": "Site breakage",
      "detail": "Hardening can break some sites and reduce features such as WebGL until re-enabled."
    },
    {
      "title": "Small volunteer team",
      "detail": "PrivacyTools notes security-fix speed depends on a few maintainers."
    },
    {
      "title": "Android only",
      "detail": "No desktop or iOS builds."
    }
  ],
  "signatureFeatures": [
    "Telemetry removed",
    "Strict ETP by default",
    "Fission site isolation",
    "Accrescent distribution"
  ],
  "faq": [
    {
      "q": "Is IronFox on Google Play?",
      "a": "No. Use Accrescent (recommended), the project F-Droid repo, Obtainium or direct APK."
    },
    {
      "q": "What is its relation to Mull?",
      "a": "It is a fork of Mull, which ended with DivestOS in Dec 2024; IronFox appeared in Jan 2025."
    },
    {
      "q": "Minimum Android?",
      "a": "Android 5 (API 21); arm64, armv7 and x86_64 builds exist."
    }
  ],
