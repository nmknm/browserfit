  "pitch": "The sidebar-and-Spaces browser that is shutting down on December 22, 2026.",
  "summary": "Arc popularised vertical sidebar tabs and Spaces. The Browser Company announced on Oct 22, 2026 that desktop Arc stops working on Dec 22, 2026 and points users to Dia.",
  "bestFor": [
    "Existing Arc users migrating before the cutoff"
  ],
  "notFor": [
    "Anyone starting a new browser setup (no new accounts)",
    "Long-term use after Dec 22, 2026"
  ],
  "pros": [
    {
      "title": "Spaces and sidebar",
      "detail": "Well-loved organization model still copied by Crest, Ardia, Zen."
    },
    {
      "title": "Chrome extension support",
      "detail": "Chromium base."
    },
    {
      "title": "Dia import",
      "detail": "Dia brings over passwords, bookmarks, extensions, history; Spaces become Profiles."
    },
    {
      "title": "Mature UX",
      "detail": "Polished sidebar and command-bar workflow refined over several years."
    }
  ],
  "cons": [
    {
      "title": "Shutting down",
      "detail": "Desktop stops Dec 22, 2026; accounts deactivated and data purged within 30 days."
    },
    {
      "title": "No new accounts",
      "detail": "Disabled Oct 22, 2026."
    },
    {
      "title": "No feature work",
      "detail": "Halted since May 2025."
    }
  ],
  "signatureFeatures": [
    "Spaces",
    "Sidebar tabs",
    "Split View",
    "Boosts"
  ],
  "faq": [
    {
      "q": "When does Arc stop working?",
      "a": "Dec 22, 2026 on macOS and Windows; Arc Search AI and sync end Nov 23."
    },
    {
      "q": "Where do I go?",
      "a": "The Browser Company recommends Dia; others include Zen, Crest and Ardia; use Export Data in Arc first for non-Dia browsers."
    },
    {
      "q": "What about Arc Search?",
      "a": "iOS keeps working as a plain mobile browser; Android is removed from Google Play."
    }
  ],
