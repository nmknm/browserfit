    {
      "title": "Deep enterprise controls",
      "detail": "Group Policy and IEAK enabled rich enterprise management."
    },
    {
      "title": "Legacy app compatibility",
      "detail": "Ran ActiveX and old intranet apps; Edge IE mode continues this to at least 2029."
    },
    {
      "title": "Preinstalled",
      "detail": "Shipped with Windows NT 4.0 through Windows 10 21H2."
    },
    {
      "title": "Tiny footprint",
      "detail": "No separate download; part of Windows."
    }
