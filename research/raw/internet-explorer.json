  "faq": [
    {
      "q": "When did Internet Explorer end?",
      "a": "Support ended June 15, 2022 for Windows 10 Semi-Annual Channel editions; IE 11 was the final release."
    },
    {
      "q": "Can I still use IE-only sites?",
      "a": "Yes, through Microsoft Edge IE mode, which Microsoft has committed to support through at least 2029 with one year notice."
    },
    {
      "q": "Does IE run on Windows 11?",
      "a": "Windows 11 disables the normal way of launching it."
    }
