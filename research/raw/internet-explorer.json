  "cons": [
    {
      "title": "No longer supported",
      "detail": "Retired for Windows 10 SAC on June 15, 2022; Windows 11 disables the normal launch path."
    },
    {
      "title": "Obsolete engine",
      "detail": "Trident/Chakra lacks modern web standards."
    },
    {
      "title": "Security risk",
      "detail": "Unpatched on consumer Windows; ActiveX and BHO attack surface."
    },
    {
      "title": "No extensions ecosystem",
      "detail": "Only legacy add-ons (ActiveX/BHO), nothing compatible with current web."
    }
