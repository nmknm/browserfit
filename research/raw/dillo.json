  "pitch": "Tiny graphical browser with no JavaScript, built for old and low-power machines.",
  "summary": "Dillo is a small graphical browser written in C++ on FLTK. It has no JavaScript and handles only a subset of CSS, but starts instantly and runs on very old hardware. Version 3.3.0 arrived in April 2026.",
  "bestFor": [
    "Very old or low-power computers",
    "Reading static, text-heavy pages",
    "Minimalists who want no JavaScript at all"
  ],
  "notFor": [
    "Modern web apps, logins and video",
    "People who need an audited, sandboxed browser"
  ],
  "pros": [
    {
      "title": "Extremely light",
      "detail": "Fast start and a tiny memory footprint."
    },
    {
      "title": "No JavaScript",
      "detail": "Removes a large part of tracking and attack surface."
    },
    {
      "title": "Recent releases",
      "detail": "3.2.0 (Jan 2025) added WebP and SVG; 3.3.0 (Apr 2026) adds experimental FLTK 1.4 support."
    },
    {
      "title": "Configurable",
      "detail": "Options such as link actions, new tab page and image-format ignoring."
    }
  ],
  "cons": [
    {
      "title": "Breaks most modern sites",
      "detail": "No JavaScript and partial CSS support."
    },
    {
      "title": "No sandbox",
      "detail": "A C/C++ program with a memory-safety bug history, including a TLS use-after-free fixed in 3.2.0."
    },
    {
      "title": "Domain warning",
      "detail": "dillo.org is no longer controlled by the developers; the real site is dillo-browser.org."
    }
  ],
  "signatureFeatures": [
    "Instant startup",
    "No JavaScript",
    "FLTK interface",
    "Custom link actions"
  ],
  "faq": [
    {
      "q": "Does Dillo support JavaScript?",
      "a": "No."
    },
    {
      "q": "Which site is official?",
      "a": "dillo-browser.org. The old dillo.org domain has not been under the developers’ control since December 2023."
    },
    {
      "q": "What changed in 3.3.0?",
      "a": "It adds new features, configuration options and fixes, and is the first release with experimental FLTK 1.4 support."
    }
