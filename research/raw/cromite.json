  "pitch": "Bromite successor: Chromium with built-in ad blocking and anti-fingerprinting.",
  "summary": "A hardened Chromium fork carrying on Bromite with built-in content blocking, DoH and fingerprint-resistance patches. Runs on Android 8+, Windows and Linux; no extension support and no Play Store listing.",
  "bestFor": [
    "Android users wanting built-in blocking without extensions",
    "Former Bromite users",
    "People who want a privacy-tuned Chromium engine"
  ],
  "notFor": [
    "Anyone needing extensions or sync",
    "People wanting Google Play updates",
    "Users needing Netflix/DRM"
  ],
  "pros": [
    {
      "title": "Built-in blocking",
      "detail": "Content filtering and DNS-over-HTTPS are included without extensions."
    },
    {
      "title": "Anti-fingerprinting patches",
      "detail": "Carries Bromite-lineage fingerprinting and hardening patches (privacytools labels it Hardened)."
    },
    {
      "title": "Open source",
      "detail": "GPL-3.0 with patches public on GitHub."
    },
    {
      "title": "Modern Blink engine",
      "detail": "Chromium 153 base gives Chrome-level site compatibility."
    },
    {
      "title": "Android, Windows and Linux",
      "detail": "APKs for arm64, arm and x86_64, plus Windows zip and Linux tarball."
    }
  ],
  "cons": [
    {
      "title": "No extensions",
      "detail": "No extension ecosystem on Android; desktop extension handling not documented."
    },
    {
      "title": "Not on Google Play",
      "detail": "Installed from GitHub releases, so updates are manual or via third-party repositories."
    },
    {
      "title": "Single maintainer",
      "detail": "Privacytools notes keeping pace with Chromium security updates is a real burden."
    },
    {
      "title": "No sync",
      "detail": "No account or sync mechanism and no DRM playback."
    }
  ],
  "signatureFeatures": [
    "Built-in content blocker",
    "Anti-fingerprinting patches",
    "DNS-over-HTTPS",
    "No Google services"
  ],
  "faq": [
    {
      "q": "Is Cromite on Google Play?",
      "a": "No. Releases are distributed through GitHub (APK, Windows zip, Linux tarball)."
    },
    {
      "q": "How is it related to Bromite?",
      "a": "Cromite is a fork of Bromite created in 2023 after Bromite stopped being maintained in late 2022."
    },
    {
      "q": "Does it support extensions?",
      "a": "No extensions on Android. Desktop extension handling is not documented in sources reviewed."
    }
  ],
