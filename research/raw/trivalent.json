  "pitch": "Hardened Chromium for desktop Linux, inspired by Vanadium and tuned for secureblue.",
  "summary": "Trivalent is a security-focused Chromium build for desktop Linux from the secureblue project. It adds hardening patches, makes extras like the password manager and search suggestions opt-in, and is built for Fedora Atomic systems.",
  "bestFor": [
    "secureblue and Fedora users who want a hardened browser",
    "Security-minded Linux users who accept Chromium",
    "People who liked Vanadium on Android"
  ],
  "notFor": [
    "Windows or macOS users",
    "People who need Manifest V2 extensions",
    "Anyone who wants a polished installer on any distro"
  ],
  "pros": [
    {
      "title": "Hardening patches",
      "detail": "Adds patches and sandbox flags on top of Fedora’s Chromium, ported partly from Vanadium."
    },
    {
      "title": "Opt-in extras",
      "detail": "The password manager and search suggestions are opt-in by default."
    },
    {
      "title": "Strict defaults",
      "detail": "Strict pop-up blocking and Chromium’s subresource filter are enabled."
    },
    {
      "title": "Fast upstream tracking",
      "detail": "Security fixes follow Chromium quickly."
    }
  ],
  "cons": [
    {
      "title": "Fedora-centric",
      "detail": "Official support is only through secureblue; other installs are unsupported."
    },
    {
      "title": "No MV2",
      "detail": "The project treats re-enabling Manifest V2 as out of scope for security reasons."
    },
    {
      "title": "No clear release page",
      "detail": "The GitHub Releases section is empty; versions come from the repo."
    }
  ],
  "signatureFeatures": [
    "Hardened Chromium patches",
    "Opt-in password manager",
    "Strict pop-up blocker",
    "hardened_malloc support"
  ],
  "faq": [
    {
      "q": "How is Trivalent related to Vanadium?",
      "a": "It is inspired by Vanadium and includes Vanadium’s desktop-relevant patches."
    },
    {
      "q": "Can I install it on any Linux distribution?",
      "a": "Official support is only through secureblue; Fedora users can install from the secureblue repo unofficially."
    },
    {
      "q": "Is it open source?",
      "a": "Yes. The repo includes GPL-2.0 licensing alongside Chromium’s own licenses."
    }
  ],
