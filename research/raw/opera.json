  "pros": [
    {
      "title": "Free built-in VPN",
      "detail": "A free browser-only proxy VPN with no data cap on desktop."
    },
    {
      "title": "Built-in ad blocker",
      "detail": "Ad and tracker blocking is built in, opt-in."
    },
    {
      "title": "MV2 still works (for now)",
      "detail": "Opera still supports Manifest V2 add-ons but says it will move to MV3 eventually."
    },
    {
      "title": "Workspaces and Tab Islands",
      "detail": "Strong tab organization, tiling and sidebar apps."
    },
    {
      "title": "Aria AI",
      "detail": "Built-in assistant on desktop and mobile, with Opera Neon as a separate agentic browser."
    }
  ],
  "cons": [
    {
      "title": "Ownership",
      "detail": "Majority-owned by Kunlun Tech of Beijing, which raises trust concerns for some users."
    },
    {
      "title": "Not open source",
      "detail": "Proprietary UI on top of Chromium."
    },
    {
      "title": "MV2 on borrowed time",
      "detail": "The add-ons store stopped new MV2 uploads and blocks older low-use ones."
    },
    {
      "title": "Chromium lag",
      "detail": "Ships Chromium roughly one major behind Chrome."
    }
  ],
  "signatureFeatures": [
    "Free browser VPN",
    "Aria AI",
    "Tab Islands and Workspaces",
    "Sidebar messengers and Flow",
    "MV2 extensions support (for now)"
  ],
  "faq": [
    {
      "q": "Does Opera still support Manifest V2?",
      "a": "Yes, for now. Opera has said it will move to MV3 eventually and has restricted new MV2 uploads to its add-ons store; no end date was found."
    },
    {
      "q": "Is the Opera VPN really free?",
      "a": "On desktop the built-in VPN is a free proxy limited to the browser, with no data cap; the device-wide VPN Pro is paid."
    },
    {
      "q": "What is the difference between Opera One, GX, Air and Neon?",
      "a": "One is the main browser, GX is the gaming variant (also on Linux since March 2026), Air focuses on mindfulness and Neon is an agentic AI browser."
    }
  ],
