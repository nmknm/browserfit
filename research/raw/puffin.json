  ],
  "pros": [
    {
      "title": "Light on the device",
      "detail": "HTML rendering happens in the cloud; only rasterization is local."
    },
    {
      "title": "Remote isolation",
      "detail": "Enterprise Puffin Secure Browser keeps web content off endpoints."
    },
    {
      "title": "Multiple platforms",
      "detail": "Google Play and App Store apps, desktop edition."
    },
    {
      "title": "Reasonable consumer price",
      "detail": "Older listings show about $1/month or $5/year."
    }
  ],
  "cons": [
    {
      "title": "Privacy trade-off",
