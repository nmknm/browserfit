    {
      "title": "Open and independent",
      "detail": "MPL-2.0 project maintained by Igalia, not tied to a headset maker."
    },
    {
      "title": "Wide device support",
      "detail": "Quest, Pico 4 and Neo 3, Magic Leap 2, Lynx R1 and Huawei glasses."
    },
    {
      "title": "Two engines",
      "detail": "A Gecko build and a Chromium build, chosen per need and device."
    },
    {
      "title": "VR video focus",
      "detail": "The latest Gecko release adds VR video projection modes."
    }
  ],
  "cons": [
    {
      "title": "Small team",
      "detail": "A smaller project than Meta’s or Pico’s own browsers."
    },
    {
      "title": "Some video sites block it",
      "detail": "A Chromium update restored support for VR video sites that had begun blocking non-Meta browsers."
    },
    {
      "title": "Sparse docs on privacy",
      "detail": "Ad blocking and tracking-protection details are not clearly documented."
    }
