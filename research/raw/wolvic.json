  "faq": [
    {
      "q": "Is Wolvic the successor to Firefox Reality?",
      "a": "Yes. Mozilla handed the project to Igalia in 2022, which continued it as Wolvic."
    },
    {
      "q": "Which headsets does it support?",
      "a": "Quest 2, Pro, 3 and 3S, Pico Neo3 and Pico 4, Magic Leap 2, Lynx R1 and Huawei Vision Glass and VR Glass."
    },
    {
      "q": "Does it support extensions?",
      "a": "Its site lists extension support; which store or API it uses is not documented there."
    }
  ],
