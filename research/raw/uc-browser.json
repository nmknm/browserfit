  "pitch": "Data-saving Android browser with fast downloads and a long privacy-problem history.",
  "summary": "UC Browser is Alibaba's mobile browser known for proxy compression and a strong download manager. Citizen Lab and others documented insecure data handling; it is Android-only today and banned in India.",
  "bestFor": [
    "Low-bandwidth Android users who value download manager",
    "Markets where UC is the default familiar app"
  ],
  "notFor": [
    "Anyone who cares about privacy or security",
    "iOS or desktop users",
    "People in India (banned)"
  ],
  "pros": [
    {
      "title": "Strong downloader",
      "detail": "Multi-threaded download manager is a long-time signature."
    },
    {
      "title": "Data saving",
      "detail": "Proxy-server compression reduces data usage."
    },
    {
      "title": "Light on weak devices",
      "detail": "Runs acceptably on low-end Android phones."
    },
    {
      "title": "Built-in ad blocking",
      "detail": "Ad blocking is offered in the app (depth unverified)."
    }
  ],
  "cons": [
    {
      "title": "Privacy record",
      "detail": "Citizen Lab found personal data sent with weak encryption; Forbes (2021) reported IPs going to Alibaba."
    },
    {
      "title": "Proxy architecture",
      "detail": "Pages route through UCWeb servers, which weakens HTTPS guarantees."
    },
    {
      "title": "Android-only",
      "detail": "Wikipedia says only Android is supported as of 2025."
    },
    {
      "title": "Banned in India",
      "detail": "Banned in 2020 along with 58 other Chinese apps."
    },
    {
      "title": "Weak patching evidence",
      "detail": "No verifiable security release cadence or Chromium base."
    }
  ],
