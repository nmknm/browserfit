  "faq": [
    {
      "q": "Is UC Browser safe?",
      "a": "Independent researchers (Citizen Lab, Doctor Web) documented serious privacy and security flaws; treat it as high-risk."
    },
    {
      "q": "Is it still updated?",
      "a": "Wikipedia lists Android 15.1.2.1388 from March 2026, but the entry is flagged citation needed."
    },
    {
      "q": "Can I use it on iOS or Windows?",
      "a": "No. Wikipedia states Android is the only supported platform as of 2025."
    }
  ],
