    "Boosts"
  ],
  "faq": [
    {
      "q": "Is Thravik Chromium?",
      "a": "No, it runs on the system WebKit with a CDP bridge via inspect-webkit."
    },
    {
      "q": "Does it use cloud AI?",
      "a": "Ask Page and Memory are described as on-device via Apple Intelligence."
    },
    {
      "q": "What does it require?",
      "a": "macOS 26 or later."
    }
