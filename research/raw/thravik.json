  "pitch": "Native Mac WebKit browser with private on-device memory and Apple Intelligence.",
  "summary": "Native macOS 26+ browser built on system WebKit (app only a few MB). Spaces with separate logins, up to four-pane split view, tab hibernation and opt-in encrypted on-device Memory plus Ask Page via Apple Intelligence.",
  "bestFor": [
    "Mac power users wanting lightweight, native browsing",
    "People who want private on-device AI memory",
    "Arc/Dia-style tab fans"
  ],
  "notFor": [
    "Anyone not on macOS 26+",
    "Chrome-extension-dependent users",
    "People wanting an autonomous agent"
  ],
  "pros": [
    {
      "title": "Tiny footprint",
      "detail": "No bundled engine; the app is a few megabytes and background tabs hibernate."
    },
    {
      "title": "Private Memory",
      "detail": "Off by default; encrypted with AES-256-GCM using a device-only Keychain key and skips banking, health and password pages."
    },
    {
      "title": "On-device AI",
      "detail": "Ask Page and Memory answers use Apple Intelligence where available."
    },
    {
      "title": "Spaces",
      "detail": "Separate tabs, cookies and logins; Split View up to four pages."
    }
  ],
  "cons": [
    {
      "title": "macOS 26+ only",
      "detail": "Mobile and other desktop OSes are not offered (release notes hint at mobile work)."
    },
    {
      "title": "Limited extensions",
      "detail": "Extensions relying on Chrome-only APIs may not work."
    },
    {
      "title": "Early and single-developer",
      "detail": "Version 0.2.x; maker lists \"Redent\" in one reply, a naming inconsistency."
    },
    {
      "title": "Account required",
      "detail": "Login supports analytics; no-login mode only \"considered\"."
    }
  ],
