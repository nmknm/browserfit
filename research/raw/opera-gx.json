  "pros": [
    {
      "title": "GX Control limiters",
      "detail": "Cap CPU, RAM and network use of the browser; Hot Tabs Killer closes heavy tabs."
    },
    {
      "title": "Massive customisation",
      "detail": "Over 11,000 GX Mods plus themes, sounds and shaders."
    },
    {
      "title": "Native ad blocker",
      "detail": "Summer 2026 update added a faster blocker with uBlock filter compatibility."
    },
    {
      "title": "New in Oct 2026",
      "detail": "Volume Booster up to 500% and an 8-preset Audio Equalizer per tab."
    },
    {
      "title": "Broad platform reach",
      "detail": "Windows, macOS, Linux (since Mar 2026), Android and iOS."
    }
  ],
  "cons": [
    {
      "title": "Weak privacy posture",
      "detail": "Sponsored content, telemetry and an ad-driven business model."
    },
    {
      "title": "Chromium patch lag",
      "detail": "GX core 126 shipped on Chromium 142 in Jan 2026 while Chrome was newer."
    },
    {
      "title": "MV2 not guaranteed",
      "detail": "Opera says it supports MV2 \"as long as we can\" with no end date; GX-specific confirmation is missing."
    },
    {
      "title": "AI and promos in the UI",
      "detail": "Opera AI and promotional content appear by default."
    }
  ],
  "signatureFeatures": [
    "GX Control (CPU/RAM/Network limiters)",
    "GX Mods",
    "Browser Booster (Volume Booster, Equalizer)",
    "Native ad blocker and free VPN",
    "Split Screen"
  ],
  "faq": [
    {
      "q": "Is Opera GX only for gamers?",
      "a": "No. It is a regular Chromium browser with extras; the limiters and mods help gamers most."
    },
    {
      "q": "Is there Opera GX on Linux?",
      "a": "Yes, GX launched on Linux in March 2026 with built-in ad blocker and VPN."
    },
    {
      "q": "Does GX still support uBlock Origin?",
      "a": "Opera says it supports MV2 extensions like uBlock Origin for as long as it can; the built-in blocker also uses uBlock filter lists."
    }
  ],
