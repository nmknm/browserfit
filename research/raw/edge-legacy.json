  "pros": [
    {
      "title": "Light and efficient",
      "detail": "Cleaner and faster than IE11 with strong battery life for its time."
    },
    {
      "title": "Reading and notes",
      "detail": "Reading view, reading list and Web Notes annotations."
    },
    {
      "title": "Built-in PDF and Flash",
      "detail": "Integrated PDF reader and Flash until January 2021."
    },
    {
      "title": "PlayReady video",
      "detail": "Supported premium PlayReady streaming."
    }
  ],
  "cons": [
    {
      "title": "Discontinued",
      "detail": "Support ended March 9, 2021 and the April 13, 2021 update removed it."
    },
    {
      "title": "Weak compatibility",
      "detail": "EdgeHTML had gaps vs Chromium and Firefox."
    },
    {
      "title": "Tiny extension store",
      "detail": "WebExtension-based add-ons were few."
    },
    {
      "title": "Windows 10 only",
      "detail": "Not available on Windows 8.1 or earlier or LTSC builds."
    }
  ],
  "signatureFeatures": [
    "EdgeHTML engine",
    "Reading view and Web Notes",
    "Set aside tabs",
    "Cortana integration"
  ],
  "faq": [
    {
      "q": "When did Edge Legacy end?",
      "a": "Desktop support ended March 9, 2021, with removal via an April 13, 2021 update."
    },
    {
      "q": "What replaced it?",
      "a": "Chromium-based Microsoft Edge, which became the default desktop browser on January 15, 2020."
    },
    {
      "q": "Which engine did it use?",
      "a": "EdgeHTML, a fork of MSHTML, with the Chakra JavaScript engine."
    }
