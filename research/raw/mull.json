  "faq": [
    {
      "q": "Is Mull still maintained?",
      "a": "No. DivestOS and its apps, including Mull, stopped in Dec 2024."
    },
    {
      "q": "What replaces it?",
      "a": "IronFox (a fork of Mull), or Fennec F-Droid as a simpler option."
    },
    {
      "q": "Why was it discontinued?",
      "a": "Lack of funding and a single person managing the whole project."
    }
