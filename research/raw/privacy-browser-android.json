  "pitch": "Android browser that ships with JavaScript, cookies and DOM storage turned off.",
  "summary": "Privacy Browser Android is a WebView-based browser from Soren Stoutner. Version 3.20 added a filter-list system modelled on its PC sibling, and the 4.x series will move to a forked Privacy WebView.",
  "bestFor": [
    "Android users who want a locked-down, open-source browser",
    "F-Droid users",
    "People who want per-site control over JavaScript"
  ],
  "notFor": [
    "Anyone who wants a full daily browser with sync and extensions",
    "People on Android 9 or older after 3.21"
  ],
  "pros": [
    {
      "title": "Strict defaults",
      "detail": "JavaScript, DOM storage and cookies are off until you allow them."
    },
    {
      "title": "Filter lists",
      "detail": "Version 3.20 added a Filter Lists Activity modelled on Privacy Browser PC."
    },
    {
      "title": "Open source and no trackers",
      "detail": "GPL-licensed and distributed on F-Droid and Google Play."
    },
    {
      "title": "Modern targets",
      "detail": "Version 3.20 targets API 36 (Android 16)."
    }
  ],
  "cons": [
    {
      "title": "Many sites need JavaScript",
      "detail": "Enabling it per site is required for much of the modern web."
    },
    {
      "title": "WebView-bound",
      "detail": "Depends on the system WebView, which now only supports Android 10+, so 3.21 will raise the minimum API to 29."
    },
    {
      "title": "Single-developer project",
      "detail": "Release pace and Amazon listing (still 3.19.3) can lag."
    }
  ],
  "signatureFeatures": [
    "Per-site JavaScript and cookie settings",
    "Filter lists",
    "Privacy WebView (planned 4.x)",
    "Tor/Orbot support"
  ],
  "faq": [
    {
      "q": "Is Privacy Browser Android maintained?",
      "a": "Yes: 3.20 was released on 11 March 2026 and 3.20.1 on 30 March 2026."
    },
    {
      "q": "What changes in 3.21?",
      "a": "The minimum API level rises to 29 (Android 10) because System WebView supports only Android 10+."
    },
    {
      "q": "Is monocles browser related?",
      "a": "Yes. monocles browser is a fork of Privacy Browser."
    }
  ],
