  "pitch": "Korea's Chromium browser with sidebar apps, Papago translation and new AI Chat.",
  "summary": "Naver Whale is Naver's Chromium-based browser, popular in South Korea (about 8% share per MoneyToday). It bundles a sidebar, Papago translation, Whale Space multitasking and, since Oct 2026, an AI Chat assistant.",
  "bestFor": [
    "Korean-language users and Naver account holders",
    "People who like a built-in sidebar of web apps",
    "Users wanting strong Korean/English translation"
  ],
  "notFor": [
    "Privacy-first users",
    "People who dislike Naver as default search",
    "Users who need Linux-first support or an English-only UX"
  ],
  "pros": [
    {
      "title": "Sidebar and Whale Space",
      "detail": "Sidebar mini-apps, scrapbook and multitasking views are core to the design."
    },
    {
      "title": "Papago translation",
      "detail": "Naver Papago handles page translation with strong Korean quality."
    },
    {
      "title": "AI Chat in sidebar",
      "detail": "AI Chat (launched 2026-10-01) summarises pages, organises tabs and edits Naver Calendar events with confirmation."
    },
    {
      "title": "Chrome Web Store compatible",
      "detail": "Chromium base lets users add Chrome extensions alongside the Whale Store."
    },
    {
      "title": "Multi-platform",
      "detail": "Windows, macOS, Linux (per Wikipedia), Android and iOS."
    }
  ],
  "cons": [
    {
      "title": "Naver-centric",
      "detail": "Defaults and best features assume a Naver account."
    },
    {
      "title": "Telemetry and jurisdiction",
      "detail": "Closed-source with Naver data collection under Korean law."
    },
    {
      "title": "Chromium lag",
      "detail": "Changelog showed Chromium 144 in Jan 2026-era builds, behind Chrome."
    },
    {
      "title": "Limited global presence",
      "detail": "Support and UI polish are Korea-first."
    }
  ],
  "signatureFeatures": [
    "Sidebar web apps",
    "Whale Space",
    "Papago translation",
    "AI Chat",
    "Scrapbook"
  ],
  "faq": [
    {
      "q": "Is Naver Whale Chromium-based?",
      "a": "Yes, it uses Blink/V8 on desktop and Android; iOS uses WebKit."
    },
    {
      "q": "Does Whale have AI?",
      "a": "Yes. AI Chat launched on 2026-10-01 and can summarise, translate and manage Naver Calendar events from the sidebar."
    },
    {
      "q": "Where is it popular?",
      "a": "South Korea, where MoneyToday reported roughly 8% share in September 2026."
    }
  ],
