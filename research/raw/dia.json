  "pros": [
    {
      "title": "AI built into the address bar",
      "detail": "Chat with tabs, summarize and run Skills without opening a separate sidebar."
    },
    {
      "title": "Chrome extensions work",
      "detail": "Chromium base means Chrome Web Store extensions install (MV3 only)."
    },
    {
      "title": "Active release cadence",
      "detail": "v1.33.0 shipped May 28, 2026 after dozens of 1.x releases in a year."
    },
    {
      "title": "Free tier available",
      "detail": "Basic AI features are free with usage caps; Pro lifts limits for $20/mo."
    },
    {
      "title": "Backed by Atlassian",
      "detail": "Acquired for a reported $610M, completed Oct 21, 2025; deeper Confluence/Jira ties."
    }
  ],
  "cons": [
    {
      "title": "Mac only",
      "detail": "Requires macOS 14+ on Apple Silicon; Windows is still a waitlist with no date, no mobile app."
    },
    {
      "title": "Cloud AI by default",
      "detail": "Tab content goes to model providers; memory is a Pro feature with unclear data handling."
    },
    {
      "title": "Limited agent depth",
      "detail": "Skills and chat dominate; fewer autonomous multi-step agents than Comet or Opera Neon."
    },
    {
      "title": "Parent company churn",
      "detail": "Arc is being sunset in favor of Dia, so priorities shift with Atlassian strategy."
    }
  ],
  "signatureFeatures": [
    "AI chat in the address bar",
    "Skills",
    "Personalized memory (Pro)",
    "Live Groups for Gmail/Notion/Confluence"
  ],
  "faq": [
    {
      "q": "Is Dia free?",
      "a": "Yes with usage caps; Dia Pro at $20/mo removes limits and adds memory."
    },
    {
      "q": "Is there a Windows version?",
      "a": "Not publicly. As of mid-2026 Windows is waitlist-only with no release date."
    },
    {
      "q": "Does Dia support Chrome extensions?",
      "a": "Yes, as a Chromium browser; Manifest V2 extensions are being phased out in favor of MV3."
    }
