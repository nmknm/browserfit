  "pros": [
    {
      "title": "Open source",
      "detail": "AGPL-3.0 with a very active GitHub repo (about 14k stars)."
    },
    {
      "title": "Bring your own model",
      "detail": "Works with API keys or local models via Ollama and LM Studio."
    },
    {
      "title": "MCP integration",
      "detail": "neo connects one-click to Claude Code, Codex, Cursor, VS Code and more."
    },
    {
      "title": "Linux support",
      "detail": "AppImage and deb builds, rare among AI browsers."
    },
    {
      "title": "Privacy transparency",
      "detail": "Neo keeps sessions locally and says it never sends URLs, prompts or screenshots; telemetry has one off toggle."
    }
  ],
