  "faq": [
    {
      "q": "Is BrowserOS free?",
      "a": "Yes, open source under AGPL-3.0; you supply API keys or run local models."
    },
    {
      "q": "Does it support Chrome extensions?",
      "a": "Yes, docs say Chrome extensions work as it is a Chromium fork; MV2 status is not documented."
    },
    {
      "q": "What is neo?",
      "a": "A secondary browser built for AI agents that runs alongside Chrome and imports your logins and extensions."
    }
