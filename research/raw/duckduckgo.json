  "pitch": "Simple, privacy-first browser with Fire Button, tracker blocking and optional Duck.ai.",
  "summary": "A lightweight privacy browser built on each OS's web engine: tracker blocking, Fire Button, Duck Player and YouTube ad blocking, Duck.ai on demand (one-click off). No extensions. No Linux version.",
  "bestFor": [
    "Beginners wanting privacy with no setup",
    "iPhone and Android users",
    "People who want a simple Duck.ai-integrated browser"
  ],
  "notFor": [
    "Extension users",
    "People needing deep customisation or vertical tabs",
    "Linux users (no official build)"
  ],
  "pros": [
    {
      "title": "Simple and private by default",
      "detail": "Tracker blocking, cookie pop-up handling and HTTPS upgrades work out of the box."
    },
    {
      "title": "Fire Button",
      "detail": "One tap clears tabs and data."
    },
    {
      "title": "YouTube ad blocking",
      "detail": "Duck Player and ad blocking on by default for most users (Q3 2026) on macOS, Windows, Android and iOS."
    },
    {
      "title": "AI with a kill switch",
      "detail": "Duck.ai access with one-click \"Use DuckDuckGo Without AI\" on Windows and macOS."
    },
    {
      "title": "Encrypted sync",
      "detail": "Sync & Backup syncs bookmarks and passwords end-to-end encrypted without email."
    }
  ],
  "cons": [
    {
      "title": "No extensions",
      "detail": "No extension support on any platform."
    },
    {
      "title": "Limited settings",
      "detail": "Few tabs, appearance and advanced controls."
    },
    {
      "title": "No Linux build",
      "detail": "No official Linux browser; DDG points to its extensions."
    },
    {
      "title": "Engine differences",
      "detail": "Behaviour varies by OS engine; WebKit/WebView2 patch speed depends on the OS."
    }
  ],
