  "faq": [
    {
      "q": "Is there a DuckDuckGo browser for Linux?",
      "a": "No official Linux browser as of Oct 2026; DDG offers extensions for Firefox/Chromium-based browsers instead."
    },
    {
      "q": "Does it support extensions?",
      "a": "No extensions on desktop or mobile."
    },
    {
      "q": "Can I turn AI off?",
      "a": "Yes: there is a one-click AI shutoff on Windows and macOS."
    }
  ],
