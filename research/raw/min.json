  "pitch": "Fast, minimal Electron browser with built-in blocking, reader view and local translation.",
  "summary": "Min is a lightweight Electron-based browser with a unified search/address bar, tasks (tab groups), tracker and ad blocking, reader view and userscripts. It has no extension store or sync, but 1.35 added local page translation via Bergamot.",
  "bestFor": [
    "People wanting a clean, simple browser with built-in blocking",
    "Raspberry Pi and older desktop use",
    "Privacy-minded users who do not need extensions"
  ],
  "notFor": [
    "People who rely on browser extensions or sync",
    "Netflix/DRM streaming",
    "Users who need frequent security patching"
  ],
  "pros": [
    {
      "title": "Clean, fast UI",
      "detail": "Unified search bar and \"tasks\" grouping keep the interface small."
    },
    {
      "title": "Built-in blocking",
      "detail": "Ad and tracker blocking, plus image/script blocking, without extensions."
    },
    {
      "title": "Local translation",
      "detail": "Version 1.35.0 runs page translation locally via Bergamot."
    },
    {
      "title": "Userscripts and reader view",
      "detail": "Supports userscripts and automatic reader view."
    },
    {
      "title": "No telemetry",
      "detail": "Open source (Apache-2.0) and does not phone home."
    }
  ],
  "cons": [
    {
      "title": "No extensions or sync",
      "detail": "No extension support and no cross-device sync."
    },
    {
      "title": "Electron overhead",
      "detail": "Memory and startup are not much better than mainstream Chromium browsers."
    },
    {
      "title": "Slow patch rhythm",
      "detail": "Chromium bumps appeared roughly every 1-3 months in the 1.35.x series."
    },
    {
      "title": "Small maintainer base",
      "detail": "Release history shows long gaps (e.g. none between Oct 2025 and Jan 2026)."
    }
  ],
  "signatureFeatures": [
    "Tasks (tab groups)",
    "Built-in content blocking",
    "Reader view",
    "Local translation (Bergamot)",
    "Userscripts"
  ],
  "faq": [
    {
      "q": "Does Min support Chrome extensions?",
      "a": "No. It supports userscripts but not Chrome Web Store extensions."
    },
    {
      "q": "Is Min Chromium-based?",
      "a": "Yes. It runs on Electron, so it uses Chromium."
    },
    {
      "q": "Does Min sync?",
      "a": "No built-in sync was found in its documentation."
    }
  ],
