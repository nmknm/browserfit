  "pitch": "Firefox fork with vertical tabs, workspaces and Chrome extension installs.",
  "summary": "Japanese Firefox fork with vertical tabs, workspaces, split view, panel sidebar, custom CSS and, since 12.11, installing Chrome Web Store extensions. Also adds MCP server support. Desktop only (iOS beta announced).",
  "bestFor": [
    "Firefox users who want vertical tabs and workspaces",
    "People who want both Firefox add-ons and Chrome Web Store extensions",
    "Tinkerers who like custom CSS"
  ],
  "notFor": [
    "Beginners who want zero setup",
    "People who want a long-established team",
    "Anyone who needs an Android app"
  ],
  "pros": [
    {
      "title": "Firefox add-ons plus Chrome extensions",
      "detail": "Since 12.11 (March 2026) the Chrome Web Store shows an Add to Floorp button, with some API gaps."
    },
    {
      "title": "Rich layout tools",
      "detail": "Vertical tabs, workspaces, split view, panel sidebar and multi-row layouts are built in."
    },
    {
      "title": "Full MV2 uBlock Origin",
      "detail": "Firefox engine keeps MV2 add-ons working."
    },
    {
      "title": "Fast release pace",
      "detail": "Versions 12.18.1 to 12.21.0 shipped within five weeks."
    },
    {
      "title": "Open source and free",
      "detail": "MPL-2.0 core, no paid tier."
    }
  ],
  "cons": [
    {
      "title": "Chrome extension support is partial",
      "detail": "Some extensions fail due to API differences (e.g. capture APIs); a warning says they are not Mozilla-vetted."
    },
    {
      "title": "No Android app",
      "detail": "Only an iOS/iPadOS beta was announced in August 2026."
    },
    {
      "title": "Small team",
      "detail": "Developed by a small Japanese group; long-term support depends on it."
    },
    {
      "title": "Not beginner friendly",
      "detail": "A press review criticised beginner-unfriendliness."
    }
  ],
  "signatureFeatures": [
    "Workspaces and vertical tabs",
    "Chrome Web Store installs (12.11)",
    "Panel sidebar",
    "Custom CSS and Lepton theme",
    "MCP server support (12.8)"
  ],
  "faq": [
    {
      "q": "Can Floorp install Chrome extensions?",
      "a": "Yes, since Floorp 12.11 (March 2026), though some extensions do not work because of API differences."
    },
    {
      "q": "Is Floorp based on Firefox ESR?",
      "a": "No, since 12.1.0 it returned to the rapid-release Firefox base after a period on ESR."
    },
    {
      "q": "Is there a mobile version?",
      "a": "An iOS/iPadOS beta was announced in August 2026; there is no Android release."
    }
  ],
